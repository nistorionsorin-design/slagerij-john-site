# Names only — values live in Vercel → Project → Settings → Environment Variables (D-26: no secret in this repo).
# The bestelbon (api/order.js). Without RESEND_API_KEY `npm run dev` dry-runs: the mails and the WhatsApp text are
# printed in the dev-server terminal, nothing is sent.
RESEND_API_KEY=
ORDER_MAIL_FROM=
ORDER_MAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ORDER_WHATSAPP_TO=
TWILIO_CONTENT_SID=
ORDER_DRY_RUN=
# The metrics spine (row 13b: api/hit.js, api/wa.js → src/lib/metrics.js): the DGA metrics project's URL and the
# insert-only `ingest` key. Without them nothing is sent; `npm run dev` prints the row instead.
METRICS_URL=
METRICS_KEY=
