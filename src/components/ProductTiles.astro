---
// ProductTiles (D-37 v6, Dan 17.10 10:30 „yes 3 the recommended one” = tiles B; spec design/producten-hero.md §8.2,
// visual reference design/producten-head-v6.html) — four tiles under the /producten head: one light tint per tile, the
// cut-out large and bottom-anchored, breaking out of the tile's top (the grid's padding-top makes the room; nothing up
// the tree clips), standing on a contact shadow; title in the site serif + the category line at the foot. No constant
// motion (the head is the only thing that moves): hover / focus lifts the product a little, none under reduced motion.
// The images wait in a <template> per tile and are inserted one painted frame after `load` (src/scripts/frames.ts;
// fetched before the head's paint they cost ≈ 0,1 s of mobile LCP, 17.10 [MEASURED-OURS] local), with a <noscript>
// copy so a tile is never empty without JS.
// Replaces the v5 ink tiles on /traiteur's tile (tiles.css, still /traiteur's own). Below the head, never the LCP:
// every image lazy, AVIF alpha + WebP alpha. Captions = lexicon §5.19 / §6 product cards; the group's H2 is visually
// hidden; the line under the tiles = lexicon §5.19 / §6 Produse (17.10). Each tile is a link to its section
// (#roemeens). Row 18 (20.10): the stage-4 filter is gone, so the tile is a plain jump — no script on the click.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Tile {
  img: ImageMetadata;
  alt: string;
  name: string;
  sub: string;
  /** the section the tile jumps to */
  href: string;
}
export interface Props {
  tiles: Tile[];
  label: string;
  line: string;
  id: string;
}
const { tiles, label, line, id } = Astro.props;

// spec §8.2: one tint per tile, in this order
const tints = ['#EADCD6', '#EBD9C8', '#F0E1E0', '#F1D9CF'];

// the product box (CSS below: left/right 8 %, top −34 px / bottom 78 px from 960; −30 / 104 on the phone) at the tile
// sizes — phone ≈ 165 × 290 (390 wide, 2 columns, gap 12), desktop ≈ 300 × 300 (1440, 4 columns, gap 14) — and each
// product's drawn width in it (object-fit: contain)
const box = { mobile: { w: 165 * 0.84, h: 290 + 30 - 104 }, desktop: { w: 300 * 0.84, h: 300 + 34 - 78 } };
const drawn = (img: ImageMetadata, bx: { w: number; h: number }) => Math.round(Math.min(bx.w, (bx.h * img.width) / img.height));
const built = await Promise.all(tiles.map(async (p, k) => {
  const sizes = `(min-width: 960px) ${drawn(p.img, box.desktop)}px, ${drawn(p.img, box.mobile)}px`;
  const opts = { src: p.img, width: p.img.width, height: p.img.height, widths: [160, 240, 320, 400, 480, 640].filter((x) => x < p.img.width) };
  const [avif, webp] = await Promise.all([getImage({ ...opts, format: 'avif', quality: 45 }), getImage({ ...opts, format: 'webp', quality: 65 })]);
  return { ...p, sizes, avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, style: `--tint:${tints[k % tints.length]}` };
}));
---
<section class="pt" aria-labelledby={id}>
  <h2 class="vh" id={id}>{label}</h2>
  <ul class="pt__grid">
    {built.map((p) => (
      <li class="pt__tile" style={p.style}>
        <a class="pt__link" href={p.href}>
          <span class="pt__cut" data-cut>
            <template data-frames><picture><source type="image/avif" srcset={p.avif} sizes={p.sizes} /><img src={p.src} srcset={p.webp} sizes={p.sizes} width={p.img.width} height={p.img.height} alt={p.alt} loading="lazy" decoding="async" /></picture></template>
            <noscript><picture><source type="image/avif" srcset={p.avif} sizes={p.sizes} /><img src={p.src} srcset={p.webp} sizes={p.sizes} width={p.img.width} height={p.img.height} alt={p.alt} loading="lazy" decoding="async" /></picture></noscript>
          </span>
          <div class="pt__txt">
            <h3 class="pt__name">{p.name}</h3>
            <p class="pt__sub">{p.sub}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p class="pt__line">{line}</p>
</section>

<script>
  import { afterLoadPaint, insertFrames } from '../scripts/frames';
  // the products: in after the head has painted
  afterLoadPaint(() => { for (const c of document.querySelectorAll<HTMLElement>('.pt__cut[data-cut]')) insertFrames(c); });
</script>

<style>
  /* ── phone: 2 × 2, 290 px tiles. Column gap 12 (spec); the row gap leaves room for the second row's products, which
     rise 30 px out of their tile, so they never cover the first row's names ── */
  .pt__grid { list-style: none; margin: 0; padding: 30px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 12px; }
  .pt__tile { position: relative; height: 290px; border-radius: 22px; background: var(--tint); }

  /* the whole tile is the link */
  .pt__link { display: block; height: 100%; color: var(--ink); text-decoration: none; border-radius: inherit; }
  .pt__link:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* the product: bottom-anchored in its box, the box's top above the tile's */
  .pt__cut { position: absolute; left: 8%; right: 8%; top: -30px; bottom: 104px; display: flex; align-items: flex-end; justify-content: center; }
  .pt__cut picture { display: contents; }
  .pt__cut img {
    position: relative;
    z-index: 1;
    display: block;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 2px #3a1e1240);
  }
  /* the contact shadow it stands on */
  .pt__cut::after {
    content: '';
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -6px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(closest-side, #3a1e1270, transparent);
  }

  /* the text at the foot: serif title in ink, the category line in #5F534B (5,4–5,9 : 1 on all four tints) */
  .pt__txt { position: absolute; left: 14px; right: 12px; bottom: 14px; }
  .pt__name { margin: 0; font-family: var(--f-display); font-weight: 500; font-size: 18px; line-height: 1.15; color: var(--ink); }
  .pt__sub { margin: 3px 0 0; font-size: 12px; line-height: 1.3; color: #5f534b; }

  /* hover / focus: the product lifts, its shadow narrows; still under reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .pt__cut img { transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .pt__cut::after { transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 350ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .pt__link:focus-visible .pt__cut img { transform: translateY(-8px) scale(1.03); }
    .pt__link:focus-visible .pt__cut::after { transform: scaleX(0.85); opacity: 0.6; }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .pt__link:hover .pt__cut img { transform: translateY(-8px) scale(1.03); }
    .pt__link:hover .pt__cut::after { transform: scaleX(0.85); opacity: 0.6; }
  }

  /* the line under the tiles */
  .pt__line { margin: 20px 0 0; max-width: 60ch; font-size: 14px; line-height: 1.5; color: var(--muted); }

  /* ── desktop: four in a row, 300 px tiles, gap 14; the grid's padding-top 44 px is the products' room ── */
  @media (min-width: 960px) {
    .pt__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; padding-top: 44px; }
    .pt__tile { height: 300px; }
    .pt__cut { top: -34px; bottom: 78px; }
    .pt__txt { left: 18px; right: 18px; bottom: 16px; }
    .pt__name { font-size: 22px; }
    .pt__sub { margin-top: 2px; font-size: 12.5px; }
    .pt__line { margin-top: 24px; font-size: 15px; }
  }
</style>
