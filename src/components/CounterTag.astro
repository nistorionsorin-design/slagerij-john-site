---
// CounterTag — the butcher's price tag (brief §4, board „Toog” · „Toogetiket · product”): name · one cooking line ·
// price per unit, the pin hole on the left. The board's CSS 1:1: grid 1fr auto, padding 14 16 14 34, radius 10,
// name Fraunces 600 19 px, line 12 px muted, price 26 px 700 tabular (a placeholder price 20 px, as on board Main).
// Price colour: oxblood (brief §2–3 „prices in oxblood”; the hero's tags do the same).
// Tones: paper (the counter) · ink („aanbevolen pakket”: dark, price in the accent yellow). Nothing is baked in.
// Stage 4: `id` = the product's anchor (/producten#mici, also the Product @id in its JSON-LD); the price never wraps
// (board Producten: white-space nowrap on the price).
export interface Props {
  name: string;
  line?: string;
  price?: string;
  unit?: string;
  tone?: 'paper' | 'ink';
  /** heading level of the name inside its section */
  as?: 'h3' | 'h4';
  id?: string;
}
const { name, line, price, unit, tone = 'paper', as: H = 'h3', id } = Astro.props;
const placeholder = !!price && price.startsWith('[');
---
<article class:list={['tag', `tag--${tone}`]} id={id}>
  <span class="tag__pin" aria-hidden="true"></span>
  <div class="tag__text">
    <H class="tag__name">{name}</H>
    {line && <p class="tag__line">{line}</p>}
  </div>
  {price && (
    <p class="tag__price">
      <span class:list={['tag__amount', { 'tag__amount--ph': placeholder }]}>{price}</span>
      {unit && <span class="tag__unit">{unit}</span>}
    </p>
  )}
</article>

<style>
  .tag {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 14px 16px 14px 34px;
    background: var(--tag);
    border: 1px solid var(--tag-line);
    border-radius: var(--r-tag);
    color: var(--fg);
  }
  .tag__pin {
    position: absolute;
    left: 13px;
    top: 50%;
    margin-top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--tag-pin);
  }
  .tag__text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tag__name {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: var(--fs-tag);
    line-height: 1.1;
    letter-spacing: 0;
  }
  .tag__line { margin: 0; font-size: var(--fs-caption); line-height: 1.35; color: var(--muted); }
  .tag__price { margin: 0; display: flex; align-items: baseline; gap: 3px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tag__amount { font-size: var(--fs-price); font-weight: 700; letter-spacing: -0.02em; color: var(--ox); }
  .tag__amount--ph { font-size: 20px; }
  .tag__unit { font-size: var(--fs-caption); color: var(--muted); }

  .tag--ink { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
  .tag--ink .tag__pin { border: 0; }
  .tag--ink .tag__line, .tag--ink .tag__unit { color: var(--on-ink-muted); }
  .tag--ink .tag__amount { color: var(--accent); }
</style>
