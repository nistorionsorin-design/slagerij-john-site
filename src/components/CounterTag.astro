---
// CounterTag — the butcher's price tag (brief §4, board „Toog” · „Toogetiket · product”): name · one cooking line ·
// price per unit, the pin hole on the left. The board's CSS 1:1: grid 1fr auto, padding 14 16 14 34, radius 10,
// name Fraunces 600 19 px, line 12 px muted, price 26 px 700 tabular (a placeholder price 20 px, as on board Main).
// Price colour: oxblood (brief §2–3 „prices in oxblood”; the hero's tags do the same).
// Tones: paper (the counter) · ink („aanbevolen pakket”: dark, price in the accent yellow). Nothing is baked in.
// Stage 4: `id` = the product's anchor (/producten#mici, also the Product @id in its JSON-LD); the price never wraps
// (board Producten: white-space nowrap on the price).
// Row 5b (D-34): `thumb` = a products.json id; if that product has its own photo (src/lib/thumbs.ts) it shows at 64 px
// left of the name (/producten only). Without one the tag is exactly the tag above: no empty box.
// Row 15c: the cooking line keeps a number and its unit on one row (keepUnits: „180 °C”, „45 min”, „3 u”).
import Thumb from './Thumb.astro';
import { thumbOf } from '../lib/thumbs';
import { keepUnits } from '../lib/typo';
import type { Locale } from '../i18n/ui';
export interface Props {
  name: string;
  line?: string;
  price?: string;
  unit?: string;
  tone?: 'paper' | 'ink';
  /** heading level of the name inside its section */
  as?: 'h3' | 'h4';
  id?: string;
  /** product id whose photo opens the tag (row 5b) */
  thumb?: string;
  locale?: Locale;
  /** row 17 (lexicon §5.29): the product's recipe — a small text link under the line („Recept →” → /recepten#<id>) */
  recipe?: { href: string; label: string };
}
const { name, line, price, unit, tone = 'paper', as: H = 'h3', id, thumb, locale = 'nl', recipe } = Astro.props;
// „Recept →”: the arrow is drawn, not read
const recipeWord = recipe?.label.replace(/\s*→\s*$/, '');
const hasThumb = !!thumbOf(thumb);
const placeholder = !!price && price.startsWith('[');
// row 15 (lexicon §5.30): a price in words — „prijs in de winkel” / „op aanvraag” (RO „preț în magazin” / „la cerere”) —
// is the owners' answer, not a figure: a smaller size that may wrap, so the name and the line keep their column at 390 px.
// One-word prices (the board's ink „offerte”) keep the price size.
const word = !!price && !placeholder && !/\d/.test(price) && price.trim().includes(' ');
---
<article class:list={['tag', `tag--${tone}`, { 'tag--thumb': hasThumb }]} id={id}>
  <span class="tag__pin" aria-hidden="true"></span>
  {hasThumb && thumb && <Thumb id={thumb} locale={locale} size={64} />}
  <div class="tag__text">
    <H class="tag__name">{name}</H>
    {line && <p class="tag__line">{keepUnits(line)}</p>}
    {recipe && (
      <a class="tag__recipe" href={recipe.href}>
        <svg class="tag__recipe-ic" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/></svg>
        <span>{recipeWord}</span>
        <svg class="tag__recipe-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    )}
  </div>
  {price && (
    <p class:list={['tag__price', { 'tag__price--word': word }]}>
      <span class:list={['tag__amount', { 'tag__amount--ph': placeholder, 'tag__amount--word': word }]}>{price}</span>
      {unit && <span class="tag__unit">{unit}</span>}
    </p>
  )}
</article>

<style>
  .tag {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 14px 16px 14px 34px;
    background: var(--tag);
    border: 1px solid var(--tag-line);
    border-radius: var(--r-tag);
    color: var(--fg);
  }
  .tag__pin {
    position: absolute;
    left: 13px;
    top: 50%;
    margin-top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--tag-pin);
  }
  .tag__text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .tag__name {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: var(--fs-tag);
    line-height: 1.1;
    letter-spacing: 0;
  }
  .tag__line { margin: 0; font-size: var(--fs-caption); line-height: 1.35; color: var(--muted); }
  /* row 17: the recipe link — a small oxblood pill (book · Recept · arrow) under the line, ≥ 30 px tall (WCAG 2.5.8);
     on hover it fills oxblood and the arrow steps right */
  .tag__recipe {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    margin-top: 6px;
    padding: 0 11px 0 10px;
    border-radius: 999px;
    background: var(--ox-tint);
    border: 1px solid rgba(123, 36, 32, 0.28);
    color: var(--ox);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tag__recipe-ic { width: 15px; height: 15px; flex: 0 0 auto; }
  .tag__recipe-arrow { width: 14px; height: 14px; flex: 0 0 auto; transition: transform 0.15s ease; }
  .tag__recipe:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  @media (hover: hover) {
    .tag__recipe:hover { background: var(--ox); border-color: var(--ox); color: var(--on-ox); }
    .tag__recipe:hover .tag__recipe-arrow { transform: translateX(2px); }
  }
  .tag__recipe:active { background: var(--ox); border-color: var(--ox); color: var(--on-ox); }
  .tag--ink .tag__recipe { background: rgba(242, 193, 46, 0.14); border-color: rgba(242, 193, 46, 0.45); color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .tag__recipe, .tag__recipe-arrow { transition: none; } }
  /* a narrow text column (a thumb tag at 375–390 px is ≈ 98 px) keeps the pill inside it: the book icon goes */
  .tag:has(.tag__recipe) .tag__text { container-type: inline-size; }
  @container (max-width: 116px) {
    .tag__recipe { padding: 0 10px; }
    .tag__recipe-ic { display: none; }
  }
  .tag__price { margin: 0; display: flex; align-items: baseline; gap: 3px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tag__amount { font-size: var(--fs-price); font-weight: 700; letter-spacing: -0.02em; color: var(--ox); }
  .tag__amount--ph { font-size: 20px; }
  .tag__price--word { flex-wrap: wrap; justify-content: flex-end; max-width: 7.5em; white-space: normal; text-align: right; }
  .tag__amount--word { font-size: 18px; line-height: 1.15; letter-spacing: -0.01em; }
  .tag__unit { font-size: var(--fs-caption); color: var(--muted); }

  .tag--thumb { grid-template-columns: auto 1fr auto; }

  .tag--ink { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
  .tag--ink .tag__pin { border: 0; }
  .tag--ink .tag__line, .tag--ink .tag__unit { color: var(--on-ink-muted); }
  .tag--ink .tag__amount { color: var(--accent); }
</style>
