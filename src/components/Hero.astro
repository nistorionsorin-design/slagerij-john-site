---
// Hero (D-12, stage 1) — five frames, transition B (soft wipe), Ken Burns 1,00 → 1,08,
// pause (WCAG 2.2.2), reduced motion = one still. Motion CSS is design/css/hero-b.css
// ported 1:1 (src/styles/hero-b.css); this file adds only layout and the no-JS still.
// Layout from the canvas: mobile (Main) = full-screen dark hero, the sign floating on it,
// text at the bottom above the bar; desktop = board „Hero · de naad” (D-28, stage 1b):
// design/css/hero-seam.css v1.7 1:1 (stage 1c) — paper text column, the photo as a pinned print,
// the counter tag over the seam, and THE hero stamp: the ink stamp centred on the seam, left half
// oxblood on the paper, right half paper-coloured on the photo (design/svg/stamp.svg, stamp-ro.svg
// on /ro), inlined so its text uses the page fonts; the RO title scales to .76 to stay two lines. No stamp
// on the photo any more (the ring stamp left the hero 06.10 20:05; Stamp.astro stays for the footer).
// Frame 1 is a plain <img fetchpriority="high"> at opacity 1 from first paint (LCP).
// Frames 2–5, the loop frame and tags 2–5 sit in <template>s; src/scripts/hero.ts
// inserts them after `load`. Without JS, mask support or motion: one still.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/hero-b.css';
import '../styles/hero-seam.css';
import photos from '../data/photos.json';
import type { HeroPhoto } from '../data/types';
import stampNl from '../assets/stamp.svg?raw';
import stampRo from '../assets/stamp-ro.svg?raw';
import WaIcon from './WaIcon.astro';
import OpenChip from './OpenChip.astro';
import { hero as copy, wa, type Locale } from '../i18n/ui';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
// the ink stamp, inline (not <img>: an <img> SVG cannot reach the page fonts); the file's
// leading comment is dropped, the <svg> itself goes out as it is in design/svg/
const ink = (locale === 'ro' ? stampRo : stampNl).replace(/^\s*<!--[\s\S]*?-->\s*/, '');

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp}', { eager: true });

// DOM contract of hero-b.css: wipe direction and animation delay per position.
const WIPE = ['', 'w135', 'w315', 'w45', 'w225'];
const FRAME_DELAY = [-47, -38, -29, -20, -11];
const TAG_DELAY = [-45, -36, -27, -18, -9];

const frames = (photos.hero as HeroPhoto[]).slice(0, 5).map((p, i) => {
  const mod = files[`../assets/${p.src}`];
  if (!mod) throw new Error(`photos.json hero[${i}]: src/assets/${p.src} not found`);
  const img = mod.default;
  const r = (img.width / img.height).toFixed(3);
  const max = Math.min(img.width, 1600);
  const widths = [480, 768, 1080, 1600].filter((w) => w < max).concat(max);
  // The frame covers its box: on a phone the full screen (height-bound for wide photos),
  // on desktop the pinned print right of the seam (hero-seam.css: 45 % wide, 48 % from 1600 px,
  // 16 px inset top and bottom).
  // From 1600 px the photo panel is half the width (1fr 1fr).
  const sizes = `(min-width: 1600px) max(48vw, calc((100vh - 32px) * ${r})), (min-width: 960px) max(45vw, calc((100vh - 32px) * ${r})), max(100vw, calc(100vh * ${r}))`;
  const fx = p.focalX ?? 50, fy = p.focalY ?? 50;
  const style = `object-position:${fx}% ${fy}%;transform-origin:${p.zoomX ?? fx}% ${p.zoomY ?? fy}%;animation-delay:${FRAME_DELAY[i]}s`;
  return { p, img, widths, sizes, style, delay: FRAME_DELAY[i], wipe: WIPE[i], tagDelay: TAG_DELAY[i] };
});
const [first, ...rest] = frames;
const loop = first && { ...first, wipe: 'w135' };
---
{first && (
<section class="hero hw" data-hero aria-labelledby="hero-title">
  <div class="hero__text on-ink-m">
    {/* board Desktop: the text column is space-between — this lead group on top, the trust
        strip (stage 3) at the foot. On the phone the group is the whole block. */}
    <div class="hero__lead">
    <div class="hero__row">
      {/* the open chip (stage 2): on the dark photo on the phone, on the paper column from 960 px */}
      <OpenChip locale={locale} variant="im" />
      {/* the pause stands on ink at every width (the photo panel on desktop) → .on-ink */}
      <span class="hero__pause on-ink">
        <input type="checkbox" id="hero-pause" class="hp" data-pause />
        <label for="hero-pause" class="btn-icon">
          <span class="vh hero__say-pause">{t.pause}</span>
          <span class="vh hero__say-play">{t.play}</span>
          <svg class="ic-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg class="ic-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>
        </label>
      </span>
    </div>
    <div class="hero__titlebox">
      <h1 id="hero-title" class="hero__title">{t.title} <span class="hero__accent">{t.accent}</span></h1>
      <div class="hero__ink" set:html={ink} />
    </div>
    <p class="hero__sub">{t.sub}</p>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href={wa(`home-hero`)}>
        <WaIcon />
        <span>{t.primary}</span>
      </a>
      <a class="btn btn--secondary btn--lg" href={t.secondaryHref}>{t.secondary}</a>
    </div>
    </div>
  </div>
  <div class="hero__media">
    <div class="hb hb0" style={`animation-delay:${first.delay}s`}>
      <Picture
        class="hk home"
        src={first.img}
        widths={first.widths}
        sizes={first.sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={45}
        alt={first.p.alt[locale]}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        style={first.style}
      />
    </div>

    <template data-frames>
      {[...rest, loop].map((f, n) => (
        <div class:list={['hb', 'vi', f.wipe, { hbb: n === rest.length }]} style={`animation-delay:${f.delay}s`}>
          <Picture
            class="hk"
            src={f.img}
            widths={f.widths}
            sizes={f.sizes}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            quality={45}
            alt={f.p.alt[locale]}
            loading="lazy"
            decoding="async"
            style={f.style}
          />
        </div>
      ))}
    </template>

    <div class="hero__scrim" aria-hidden="true"></div>
  </div>
  <div class="hero__tag">
      {frames.map((f, i) => {
        const tag = (
          <div class:list={['ht', { home: i === 0 }]} style={`animation-delay:${f.tagDelay}s`} aria-hidden={i === 0 ? undefined : 'true'}>
            <span class="ht__pin" aria-hidden="true"></span>
            <span class="ht__text">
              <span class="ht__name">{f.p.tag.name[locale]}</span>
              <span class="ht__line">{f.p.tag.line[locale]}</span>
            </span>
            <span class="ht__price"><span class="ht__amount">{f.p.tag.price[locale]}</span><span class="ht__unit">{f.p.tag.unit[locale]}</span></span>
          </div>
        );
        return i === 0 ? tag : null;
      })}
      <template data-tags>
        {rest.map((f) => (
          <div class="ht" style={`animation-delay:${f.tagDelay}s`} aria-hidden="true">
            <span class="ht__pin"></span>
            <span class="ht__text">
              <span class="ht__name">{f.p.tag.name[locale]}</span>
              <span class="ht__line">{f.p.tag.line[locale]}</span>
            </span>
            <span class="ht__price"><span class="ht__amount">{f.p.tag.price[locale]}</span><span class="ht__unit">{f.p.tag.unit[locale]}</span></span>
          </div>
        ))}
      </template>

  </div>
</section>
)}

<script>
  import '../scripts/hero.ts';
</script>

<style>
  /* ── no-JS / pre-live still (spec: "without JS or without mask support the hero is one
     still"). hero-b.css animates frame 1's opacity and zoom from first paint; until
     hero.ts adds .is-live, frame 1 stands still at opacity 1 and tag 1 stays. ── */
  .hw:not(.is-live) .hb0 { animation: none; opacity: 1; }
  /* frames inserted by hero.ts stay inert until frame 2 is decoded and the loop goes live */
  .hw:not(.is-live) .hb.vi { animation: none; opacity: 0; }
  .hw:not(.is-live) .hk { animation: none; }
  .hw:not(.is-live) .ht.home { animation: none; opacity: 1; }
  /* start the still at the zoom value frame 1 has when the loop begins (delay −47 s =
     2 s into its 11 s zoom: 1 + 0,08 × 2/11), so going live does not jump */
  @media (prefers-reduced-motion: no-preference) {
    .hw:not(.is-live) .hk.home { transform: scale(1.0145); }
  }
  .hw:not(.is-live) .hp { display: none; }
  .hw:not(.is-live) .hero__pause { visibility: hidden; }

  /* ── layout: mobile first (canvas Main, 390 × 844) ──
     The desktop layout is design/css/hero-seam.css (D-28), global and 1:1. Scoped rules here
     out-rank it, so every layout rule that differs on the phone sits behind max-width. ── */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: 100vh;
    min-height: 100svh;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(21,17,13,.55) 0%, rgba(21,17,13,.05) 30%, rgba(21,17,13,.35) 55%, rgba(21,17,13,.96) 100%),
      linear-gradient(rgba(21,17,13,.24), rgba(21,17,13,.24));
  }
  @media (max-width: 959.98px) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      background: var(--ink);
      color: var(--on-ink);
    }
    .hero__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      background: var(--ink);
    }
    .hero__text {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      padding: calc(var(--nav-h) + 16px) var(--gutter) calc(var(--bar) + 22px + env(safe-area-inset-bottom, 0px));
    }
    /* desktop-only piece: the counter tag (the ink stamp hides itself below 960 in hero-seam.css) */
    .hero__tag { display: none; }
  }
  .hero__lead {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* the pause label says what a tap will do (lexicon §5.15) */
  .hero__say-play { display: none; }
  .hw:has(.hp:checked) .hero__say-pause { display: none; }
  .hw:has(.hp:checked) .hero__say-play { display: inline; }
  .hero__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--touch);
  }
  /* the pause: .btn-icon on ink (buttons.css); this box only places it */
  .hero__pause { position: relative; margin-left: auto; display: inline-flex; }
  .hero__title {
    margin: 0;
    color: var(--on-ink);
  }
  .hero__accent {
    display: block;
    margin-top: 14px;
    font-style: italic;
    font-weight: 400;
    font-size: var(--fs-accent);
    line-height: var(--lh-accent);
    letter-spacing: 0;
    color: var(--accent);
  }
  .hero__sub {
    margin: 0;
    max-width: 34ch;
    font-size: 14px;
    line-height: 1.45;
    color: var(--on-ink-muted);
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }
  .hero__cta .btn { width: 100%; }

  /* ── desktop (board „Hero · de naad”, D-28): hero-seam.css v1.7 places the text column (55 %,
     52 % from 1600), the photo as a pinned print, the tag over the seam and the ink stamp on the seam.
     The sign (stage 0b2) floats over it; the text column starts at 96 + 24 px. H1 size and
     max-width are in the seam file. This block adds colour, the remaining type and the pieces
     the seam file leaves to the component. ── */
  @media (min-width: 960px) {
    .hero { color: var(--fg); container-type: inline-size; }
    .hero__scrim { background: linear-gradient(180deg, rgba(21,17,13,0) 50%, rgba(21,17,13,.55) 100%); }
    .hero__lead { gap: 22px; }
    /* the pause stays in the text row (the phone is unchanged, D-28); on desktop it sits on the
       print as on the board: 32 px from its right edge, 36 px above its bottom edge (16 px inset
       → 52 from the hero's foot). The absolute text column (left 0, down to the hero's foot) is its
       containing block, so the left offset is counted from the hero's width: 100cqw − 32 − 44. */
    .hero__pause {
      position: absolute;
      left: calc(100cqw - 76px);
      bottom: 52px;
      z-index: 3;
    }
    .hero__title { color: var(--fg); }
    .hero__accent { margin-top: 22px; color: var(--ox); }
    .hero__sub { max-width: 560px; font-size: var(--fs-lead); line-height: 1.5; color: var(--fg); }
    .hero__cta { flex-direction: row; gap: 12px; margin-top: 6px; }
    .hero__cta .btn { width: auto; }

    /* the ink stamp's SVG names its fonts 'Inter Tight' / 'Fraunces' (design/svg/stamp.svg); this site
       registers them as 'Inter Tight Variable' / 'Fraunces Variable' (fonts.css), so without this the
       stamp would fall back to Arial / Georgia. CSS outranks SVG presentation attributes and carries into the
       two <use> copies (their clones take the styles of the drawing in <defs>); the file stays 1:1. */
    .hero__ink :global(text[font-family*="Inter"]) { font-family: var(--f-ui); }
    .hero__ink :global(text[font-family*="Fraunces"]) { font-family: var(--f-display); }

    /* counter tag over the seam (tag-lift is its only shadow): .hero__tag (hero-seam.css) is the
       360 px box; the five tags stack in it, bottom-aligned, and swap with the frames (hero-b.css) */
    .ht {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 14px;
      align-items: center;
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 3;
      width: 100%;
      padding: 14px 16px 14px 34px;
      background: var(--tag);
      border: 1px solid var(--tag-line);
      border-radius: var(--r-tag);
      box-shadow: var(--shadow-tag);
      color: var(--fg);
    }
    .ht__pin {
      position: absolute;
      left: 13px;
      top: 50%;
      margin-top: -6px;
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: var(--paper);
      border: 1px solid var(--tag-pin);
    }
    .ht__text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .ht__name { font-family: var(--f-display); font-weight: 600; font-size: 20px; line-height: 1.1; }
    .ht__line { font-size: var(--fs-caption); line-height: 1.35; color: var(--muted); }
    .ht__price { display: flex; align-items: baseline; gap: 3px; font-variant-numeric: tabular-nums; }
    .ht__amount { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; color: var(--ox); }
    .ht__unit { font-size: var(--fs-caption); color: var(--muted); }
  }

  /* ── wide screens (≥ 1600 px): the seam moves to 52 % and the H1 grows to 118 px (both in
     hero-seam.css); accent and lead grow with it here. ── */
  @media (min-width: 1600px) {
    .hero__accent { font-size: clamp(44px, 2.4vw, 56px); }
    .hero__sub { font-size: clamp(18px, 0.95vw, 22px); max-width: 620px; }
  }
</style>
