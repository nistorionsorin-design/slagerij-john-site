---
// Hero (D-12): first frame is a plain <img fetchpriority="high"> at opacity 1 from first paint.
// Frames 2–5 and the A/B/C transition are not built: the transition is pending Dan's choice.
import photos from '../data/photos.json';
import type { Photo } from '../data/types';

export interface Props {
  locale: 'nl' | 'ro';
  title: string;
  accent?: string;
  eyebrow?: string;
  ctaHref: string;
  ctaLabel: string;
  pauseLabel: string;
}
const { locale, title, accent, eyebrow, ctaHref, ctaLabel, pauseLabel } = Astro.props;
const frames = (photos.hero as Photo[]).slice(0, 5);
const first = frames[0];
---
<section class="hero">
  <div class="hero__bg">
    {first ? (
      <img
        src={first.src}
        alt={first.alt[locale]}
        width={first.width}
        height={first.height}
        fetchpriority="high"
        decoding="async"
        style={`object-position:${first.focalX ?? 50}% ${first.focalY ?? 50}%`}
      />
    ) : (
      <div class="hero__placeholder" aria-hidden="true"></div>
    )}
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content container">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title">
      {title}
      {accent && <em class="hero__accent">{accent}</em>}
    </h1>
    <slot />
    <a class="btn btn--accent" href={ctaHref}>{ctaLabel}</a>
  </div>
  {frames.length > 1 && (
    <button class="hero__pause" type="button" aria-label={pauseLabel} aria-pressed="false" data-pause>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
    </button>
  )}
</section>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    background: var(--ink);
    color: var(--on-ink);
    isolation: isolate;
    overflow: clip;
  }
  .hero__bg,
  .hero__placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }
  .hero__placeholder {
    background:
      radial-gradient(60% 50% at 50% 40%, rgba(242,193,46,.1), transparent 70%),
      linear-gradient(180deg, #1f1813 0%, #15110D 100%);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(21,17,13,.1) 0%, rgba(21,17,13,.55) 60%, rgba(21,17,13,.8) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 2;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 24px;
    padding-bottom: 32px;
    gap: 16px;
  }
  .hero__eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    margin: 0;
  }
  .hero__title {
    color: var(--on-ink);
    text-wrap: balance;
    max-width: 20ch;
    margin: 0;
  }
  .hero__accent {
    font-style: italic;
    font-weight: 400;
    font-size: var(--fs-accent);
    color: var(--accent);
    display: block;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    padding: 0 20px;
    border-radius: var(--r-btn);
    font-family: var(--f-ui);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .btn--accent {
    background: var(--accent);
    color: var(--on-accent);
    align-self: flex-start;
  }
  .btn--accent:hover { background: var(--accent-hi); }
  .hero__pause {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 3;
    width: var(--touch);
    height: var(--touch);
    display: grid;
    place-items: center;
    border-radius: var(--r-chip);
    border: 1px solid rgba(255,255,255,.25);
    background: rgba(21,17,13,.5);
    color: var(--on-ink);
    cursor: pointer;
  }
</style>
