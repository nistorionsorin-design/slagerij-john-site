---
// Language switch — design/css/buttons.css `.lang`: a segmented pill of two links, the current
// language marked with aria-current (a link, not a toggle; nothing to script). Both codes show
// on every width (board „Knoppen”). Looks come from buttons.css only; on ink the parent carries
// .on-ink (always ink) or .on-ink-m (ink on the phone only).
export interface Props {
  current: 'nl' | 'ro';
  nlHref: string;
  roHref: string;
  label: string;
}
const { current, nlHref, roHref, label } = Astro.props;
---
<nav class="lang" aria-label={label}>
  <a class="lang__seg" href={nlHref} hreflang="nl-BE" lang="nl" aria-current={current === 'nl' ? 'page' : undefined}>NL</a>
  <a class="lang__seg" href={roHref} hreflang="ro-BE" lang="ro" aria-current={current === 'ro' ? 'page' : undefined}>RO</a>
</nav>
