---
// Nav — canvas boards Main (mobile, overlay on the hero) and Desktop (paper, 84 px).
// No client JS (CSP script-src 'self', D-06): the mobile menu is a checkbox + :has(),
// the same pattern hero-b.css uses for its pause control.
// variant="paper" (default): on the page ground with a hairline below.
// variant="ink": mobile only, transparent over the hero, on-ink colours (stage 1 passes it).
// Buttons, the burger and the NL/RO switch take their looks from buttons.css (stage 0b):
// on ink the header carries .on-ink-m (ink on the phone, paper from 960 px).
// Desktop = .nav__right (links · NL/RO · CTA, board „Knoppen” top strip); on the phone the
// links drop out of that row into the panel under the burger.
import { Image } from 'astro:assets';
import emblem from '../assets/logo/emblem.webp';
import LangSwitch from './LangSwitch.astro';
import WaIcon from './WaIcon.astro';
import { nav, ui, home, wa, type Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
  path: string;
  alternates: { nl: string; ro: string };
  variant?: 'paper' | 'ink';
}
const { locale, path, alternates, variant = 'paper' } = Astro.props;
const t = ui[locale];
const items = nav[locale];
const isCurrent = (href: string) => path === href || (href !== '/' && href !== '/ro' && path.startsWith(href + '/'));
---
<header class:list={['nav', `nav--${variant}`, { 'on-ink-m': variant === 'ink' }]}>
  <div class="container nav__in">
    <a class="nav__brand" href={home[locale]}>
      <Image class="nav__emblem" src={emblem} width={40} height={40} densities={[1, 2]} alt="" />
      <span class="nav__words">
        <span class="nav__mark">Slagerij John</span>
        <span class="nav__place">{t.place}</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle vh" />

    <div class="nav__right">
      <nav class="nav__links" aria-label={t.menu}>
        <ul class="nav__list">
          {items.map((it) => (
            <li>
              <a
                class:list={['nav__link', { 'nav__link--seasonal': it.seasonal }]}
                href={it.href}
                aria-current={isCurrent(it.href) ? 'page' : undefined}
              >{it.label}</a>
            </li>
          ))}
        </ul>
        <a class="btn btn--primary btn--block nav__panel-cta" href={wa(`menu-${locale}`)}>
          <WaIcon />
          <span>{t.order}</span>
        </a>
      </nav>
      <LangSwitch current={locale} nlHref={alternates.nl} roHref={alternates.ro} label={t.lang} />
      <a class="btn btn--primary nav__cta" href={wa(`nav-${locale}`)}>
        <WaIcon />
        <span>{t.order}</span>
      </a>
      <label for="nav-toggle" class="btn-icon nav__burger">
        <span class="vh">{t.menu}</span>
        <svg class="ic-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="ic-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </label>
    </div>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    color: var(--fg);
  }
  .nav__in {
    position: relative;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  /* brand: emblem (D-19, small, on its own white tile) + wordmark + place line */
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    min-height: var(--touch);
  }
  .nav__emblem {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #FDFDFD;
    flex: 0 0 auto;
  }
  .nav__words { display: flex; flex-direction: column; gap: 4px; }
  .nav__mark {
    font-family: var(--f-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: var(--fs-wordmark);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  /* phone: hidden — with both NL and RO in the switch it does not fit beside them (≤ 430 px);
     header.css (stage 0b2) shows it only from 960 px as well */
  .nav__place {
    display: none;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1;
    white-space: nowrap;
  }

  /* phone: NL/RO + burger in the row; the links are the panel. With both codes in the switch the
     row needs header.css's phone sizes (stage 0b2 boards): emblem 36, wordmark 19, switch 30 px
     segments, icon button 40 — fits from 360 px. */
  .nav__right { gap: var(--space-2); flex: 0 0 auto; }
  @media (max-width: 959.98px) {
    .nav__emblem { width: 36px; height: 36px; }
    .nav__mark { font-size: 19px; }
    .nav .lang { padding: 2px; }
    .nav .lang__seg { height: 30px; min-width: 40px; padding: 0 10px; }
    .nav .btn-icon { width: 40px; height: 40px; }
  }
  .nav__cta { display: none; }

  /* burger (mobile): a .btn-icon label for the hidden checkbox */
  .nav__burger .ic-close { display: none; }
  .nav:has(.nav__toggle:checked) .ic-open { display: none; }
  .nav:has(.nav__toggle:checked) .ic-close { display: block; }
  .nav__toggle:focus-visible ~ .nav__right .nav__burger { outline: 2px solid var(--fg); outline-offset: 3px; }
  .on-ink-m .nav__toggle:focus-visible ~ .nav__right .nav__burger { outline-color: var(--on-ink); }

  /* mobile panel */
  .nav__links {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: var(--space-2) var(--gutter) var(--space-4);
    background: var(--card);
    border-bottom: 1px solid var(--line);
    color: var(--fg);
  }
  .nav:has(.nav__toggle:checked) .nav__links { display: block; }
  .nav__list { list-style: none; margin: 0; padding: 0; }
  .nav__list li + li { border-top: 1px solid var(--line); }
  .nav__link {
    display: flex;
    align-items: center;
    min-height: 52px;
    color: var(--fg);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav__link--seasonal { color: var(--ox); }
  .nav__link[aria-current] { font-weight: 700; }
  .nav__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  /* the panel sits inside .nav__right: undo that row's 46 px / −8 px CTA rule for the panel's own button */
  .nav__links .nav__panel-cta { margin: var(--space-3) 0 0; min-height: var(--btn-h); }

  /* ink variant: mobile overlay on the hero (canvas Main board) */
  .nav--ink {
    position: absolute;
    left: 0; right: 0; top: 0;
    background: transparent;
    border-bottom: 0;
    color: var(--on-ink);
  }
  .nav--ink .nav__place { color: var(--on-ink-muted); }

  @media (min-width: 960px) {
    .nav--ink {
      position: relative;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      color: var(--fg);
    }
    .nav--ink .nav__place { color: var(--muted); }
    .nav__place { display: block; }
    .nav__emblem { width: 48px; height: 48px; }
    .nav__in { gap: var(--space-6); }
    .nav__burger, .nav__toggle { display: none; }
    .nav__cta { display: inline-flex; }
    /* .nav__right from buttons.css: links 15/500 fg, gap 28, NL/RO, the 46 px CTA */
    .nav__right { gap: 28px; }
    .nav__links {
      display: block;
      position: static;
      padding: 0;
      background: transparent;
      border: 0;
    }
    .nav__list { display: flex; align-items: center; gap: 28px; }
    .nav__list li + li { border: 0; }
    .nav__link { min-height: var(--touch); font-size: 15px; }
    .nav__panel-cta { display: none; }
  }
</style>
