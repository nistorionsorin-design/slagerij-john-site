---
// Photo loop „Bij ons” (D-11 + its 07.10 addendum, brief §5) — stages 3 / 3b. Six photos (shop · people · craft ·
// barbecue · platters + q25) in five tiles: 9 s per place, 1,6 s crossfade, 0,8 s wave between tiles, opacity only. CSS
// only, the boards' scheme (Main 390, Raster 1440) with one photo more: each image runs one keyframe over the whole
// cycle (6 × 9 = 54 s); image j in tile i has the delay −(54 + 0,8·i + 9·((i − j) mod 6)) s. So at phase p tile i shows
// photo (i + p) mod 6 — every tile cycles through all six, one place ahead of its neighbour — and exactly one photo is
// off-screen. Each photo moves from tile i + 1 to tile i; the wave lets the tile that gives a photo away switch 0,8 s
// before the tile that takes it (tile 4 first, tile 0 last), and tile 4 takes the off-screen photo. So the photo entering
// a tile is never the one another tile is showing. (With five photos the wrapped photo reached tile 4 while tile 0 still
// showed it, ~3 s in every 9 — the reason for the sixth.) The two fades of one handed-over photo overlap by 0,8 s
// (wave 0,8 < crossfade 1,6, both settled), the outgoing one already below half.
// Pause = a checkbox + label (WCAG 2.2.2; `:has(:checked)` holds every image). prefers-reduced-motion: no animation,
// each tile shows its home photo (tile i = photo i; the sixth is never a home), no pause control. No script (gate:
// client-js); the optional pause when off-screen (brief §5) is left out for that reason.
// The 30 <img> share one `sizes`, so each photo is fetched once whatever tile it is in; all lazy.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import photos from '../data/photos.json';
import type { Photo } from '../data/types';
import { homeNl } from '../i18n/home';

const t = homeNl.loop;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/{hero,home,footer}/*.{jpg,jpeg,png,webp}', { eager: true });
const TILES = 5;
const subjects = (photos.loop as Photo[]).map((p) => {
  const mod = files[`../assets/${p.src}`];
  if (!mod) throw new Error(`photos.json loop: src/assets/${p.src} not found`);
  const img = mod.default;
  const max = Math.min(img.width, 1080);
  return { img, widths: [480, 768, 1080].filter((w) => w < max).concat(max), pos: `object-position:${p.focalX ?? 50}% ${p.focalY ?? 50}%`, alt: p.alt.nl };
});
const n = subjects.length; // 6
const delay = (i: number, j: number) => -(9 * n + 0.8 * i + 9 * ((((i - j) % n) + n) % n));
const sizes = '(min-width: 960px) 60vw, 100vw';
---
<section class="loop sec plw" aria-labelledby="loop-title">
  <div class="container loop__in">
    <div class="sec__head loop__head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="sec__title sec__title--accent" id="loop-title">{t.title}</h2>
    </div>
    <div class="loop__grid">
      {Array.from({ length: TILES }, (_, i) => (
        <div class="pl">
          {subjects.map((s, j) => (
            <Picture
              class:list={[{ home: i === j }]}
              src={s.img}
              widths={s.widths}
              sizes={sizes}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              quality={55}
              alt={s.alt}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              style={`${s.pos};animation-delay:${delay(i, j).toFixed(1)}s`}
            />
          ))}
        </div>
      ))}
    </div>
    <div class="loop__ctl">
      <p class="loop__hint">{t.hint}</p>
      <span class="loop__pause">
        <input type="checkbox" id="loop-pause" class="plp" data-pause />
        <label for="loop-pause" class="btn-icon">
          <span class="vh loop__say-pause">{t.pause}</span>
          <span class="vh loop__say-play">{t.play}</span>
          <svg class="ic-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg class="ic-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>
        </label>
      </span>
    </div>
  </div>
</section>

<style>
  /* ── motion: boards Main / Raster, 1:1 ── */
  .pl :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: pl 54s ease-in-out infinite;
  }
  /* 54 s = six places of 9 s: full until 7,4 s (13.704 %), out by 9 s (16.667 %), back in over the cycle's last
     1,6 s (97.037 %) — the boards' 45 s keyframe (16.44 / 20 / 96.44 %) rescaled, timings unchanged */
  @keyframes pl {
    0%, 13.704% { opacity: 1; }
    16.667%, 97.037% { opacity: 0; }
    100% { opacity: 1; }
  }
  .plp { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .plw:has(.plp:checked) .pl :global(img) { animation-play-state: paused; }
  .plw .ic-play { display: none; }
  .plw:has(.plp:checked) .ic-pause { display: none; }
  .plw:has(.plp:checked) .ic-play { display: block; }
  .plp:focus-visible + label { outline: 2px solid var(--fg); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .pl :global(img) { animation: none; }
    .pl :global(img.home) { opacity: 1; }
    .loop__ctl { display: none; }
  }
  /* the label says what a tap will do (lexicon §5.15) */
  .loop__say-play { display: none; }
  .plw:has(.plp:checked) .loop__say-pause { display: none; }
  .plw:has(.plp:checked) .loop__say-play { display: inline; }

  /* ── layout: board Main (390): padding 28 20 24, gap 14, 2 × 1fr, gap 10, heights 160 / 160 / 150 (span 2) / 160 / 160 ── */
  .loop__in { display: flex; flex-direction: column; gap: 14px; }
  .loop__head { gap: 8px; }
  .loop__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .pl { position: relative; height: 160px; border-radius: var(--r-tile); overflow: hidden; background: var(--ink); }
  .pl:nth-child(3) { grid-column: span 2; height: 150px; }
  .pl :global(picture) { display: contents; }
  .loop__ctl { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .loop__hint { margin: 0; font-size: var(--fs-caption); line-height: 1.4; color: var(--muted); }
  .loop__pause { position: relative; display: inline-flex; flex: 0 0 auto; }
  .loop__pause .btn-icon { background: var(--card); border-color: var(--fg); color: var(--fg); }

  /* ── board Raster (1440): padding 56, gap 24; head row = title left, hint + pause right (aligned to the foot);
     grid 1.25fr 1fr 1fr × 300 300, gap 14, tile 1 spans both rows; radius 16 ── */
  @media (min-width: 960px) {
    .loop__in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "head ctl" "grid grid";
      gap: 24px 32px;
      align-items: end;
    }
    .loop__head { grid-area: head; gap: 10px; }
    .loop__head .sec__title { max-width: 900px; }
    .loop__ctl { grid-area: ctl; gap: 14px; padding-bottom: 4px; }
    .loop__hint { font-size: 13px; text-align: right; }
    .loop__grid {
      grid-area: grid;
      grid-template-columns: 1.25fr 1fr 1fr;
      grid-template-rows: 300px 300px;
      gap: 14px;
    }
    .pl { height: auto; border-radius: var(--r-frame); }
    .pl:nth-child(1) { grid-row: span 2; }
    .pl:nth-child(3) { grid-column: auto; height: auto; }
  }
</style>
