---
// Photo loop (D-11): five tiles, each showing its home subject. The rotation
// (9 s per place, 1,6 s crossfade, 0,8 s wave, opacity only) is not built yet;
// this still state is also the prefers-reduced-motion state.
import photos from '../data/photos.json';
import type { Photo } from '../data/types';

export interface Props {
  locale: 'nl' | 'ro';
  heading: string;
  pauseLabel: string;
}
const { locale, heading, pauseLabel } = Astro.props;
const tiles = (photos.loop as Photo[]).slice(0, 5);
---
<section class="loop" aria-labelledby="loop-title">
  <h2 id="loop-title" class="loop__title">{heading}</h2>
  <div class="loop__grid">
    {tiles.length === 0
      ? [0, 1, 2, 3, 4].map(() => <div class="loop__tile loop__tile--empty" aria-hidden="true"></div>)
      : tiles.map((t) => (
          <figure class="loop__tile">
            <img
              src={t.src}
              alt={t.alt[locale]}
              width={t.width}
              height={t.height}
              loading="lazy"
              decoding="async"
              style={`object-position:${t.focalX ?? 50}% ${t.focalY ?? 50}%`}
            />
          </figure>
        ))
    }
  </div>
  {tiles.length > 0 && (
    <button class="btn-icon loop__pause" type="button" aria-label={pauseLabel} aria-pressed="false" data-pause>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
    </button>
  )}
</section>

<style>
  .loop { padding: 48px 0; }
  .loop__title {
    text-align: center;
    margin-bottom: 24px;
  }
  .loop__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    padding: 0 20px;
  }
  .loop__tile {
    aspect-ratio: 1 / 1;
    border-radius: var(--r-tile);
    overflow: hidden;
    background: var(--tag);
    margin: 0;
  }
  .loop__tile img { width: 100%; height: 100%; object-fit: cover; }
  .loop__tile--empty {
    background: linear-gradient(135deg, var(--tag), var(--tag-line));
  }
  /* .btn-icon (buttons.css); this only places it */
  .loop__pause { display: flex; margin: 16px auto 0; }
  @media (max-width: 720px) {
    .loop__grid { gap: 6px; padding: 0 12px; }
  }
</style>
