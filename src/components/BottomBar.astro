---
// BottomBar — mobile fixed action bar Bel · WhatsApp · Route, 72 px (U-03).
// Canvas Contact board: paper ground, hairline on top, the WhatsApp cell yellow with
// the button radius (a pill since stage 0b, --r-btn). Three real <a href> (gate a11y). Hidden on desktop.
// The WhatsApp icon is WaIcon (board „Merkiconen” A/B); Route keeps the Lucide pin: its label is
// „Route”, not the Google Maps name, so the brand-mark rule does not apply.
import WaIcon from './WaIcon.astro';
export interface Props {
  telHref: string;
  waHref: string;
  mapHref: string;
  telLabel: string;
  waLabel: string;
  mapLabel: string;
  navLabel: string;
}
const { telHref, waHref, mapHref, telLabel, waLabel, mapLabel, navLabel } = Astro.props;
---
<nav class="bar" aria-label={navLabel}>
  <a class="bar__link" href={telHref}>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
    <span>{telLabel}</span>
  </a>
  <a class="bar__link bar__link--accent" href={waHref}>
    <WaIcon size={20} />
    <span>{waLabel}</span>
  </a>
  <a class="bar__link" href={mapHref} rel="noopener">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
    <span>{mapLabel}</span>
  </a>
</nav>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    min-height: var(--bar);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 8px 10px 10px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .bar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 52px;
    color: var(--fg);
    font-size: var(--fs-caption);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--r-btn);
  }
  .bar__link svg { display: block; }
  .bar__link--accent { background: var(--accent); color: var(--on-accent); font-weight: 700; }
  @media (min-width: 960px) {
    .bar { display: none; }
  }
</style>
