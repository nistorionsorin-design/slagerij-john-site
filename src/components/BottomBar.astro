---
// BottomBar — mobile fixed action bar · Bel · WhatsApp · Route. 72px tall.
// Labels and hrefs slotted; no copy/facts baked in.
export interface Props {
  telHref: string;
  waHref: string;
  mapHref: string;
  telLabel: string;
  waLabel: string;
  mapLabel: string;
  navLabel: string;
}
const { telHref, waHref, mapHref, telLabel, waLabel, mapLabel, navLabel } = Astro.props;
---
<nav class="bar" aria-label={navLabel}>
  <a class="bar__link" href={telHref}>
    <span class="bar__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V21a1 1 0 0 1-1.09 1 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 3.21 4.09 1 1 0 0 1 4.2 3h4.09a1 1 0 0 1 1 .75l1 4a1 1 0 0 1-.29 1l-2.2 2.2a16 16 0 0 0 6 6l2.2-2.2a1 1 0 0 1 1-.29l4 1a1 1 0 0 1 .75 1z"/></svg>
    </span>
    <span class="bar__label">{telLabel}</span>
  </a>
  <a class="bar__link bar__link--accent" href={waHref}>
    <span class="bar__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    </span>
    <span class="bar__label">{waLabel}</span>
  </a>
  <a class="bar__link" href={mapHref}>
    <span class="bar__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    </span>
    <span class="bar__label">{mapLabel}</span>
  </a>
</nav>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--bar);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background: var(--card);
    border-top: 1px solid var(--line);
    z-index: 50;
  }
  .bar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    color: var(--fg);
    font-size: 12px;
    font-weight: 600;
    min-height: var(--touch);
  }
  .bar__link--accent { background: var(--accent); color: var(--on-accent); }
  .bar__icon svg { display: block; }
  @media (min-width: 960px) {
    .bar { display: none; }
  }
</style>
