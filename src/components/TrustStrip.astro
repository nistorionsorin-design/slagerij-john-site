---
// Trust strip (U-15, lexicon §5.6: only verifiable items) — stage 3.
// Phone (board Main): a band right under the hero, 2 columns, hairline below.
// Desktop (board Desktop): one row at the foot of the hero's text column, hairline above (hero-seam.css DOM:
// `.hero__trust`, the text column is space-between). One component, two placements: `place="hero"` renders inside
// the hero, `place="band"` after it; the other one is display: none, so a reader meets the list once.
// The hero's text column is absolute and the hero is one screen high, so on a short or narrow screen (< 760 px high,
// e.g. a 1366 × 768 screen minus the browser bar; or < 1200 px wide, where the strip wraps to three rows) it would crowd
// the buttons or be clipped: there it stays the band under the hero, in rows on the paper. Measured: 1280 × 720 left
// 12 px between the buttons and the strip, 1024 × 768 0 px, 1024 × 640 clipped it; 1366 × 768 leaves 23 px.
// Icons: Lucide, stroke 2 (brief §3); Too Good To Go = the neutral bag from BrandIcon until the official badge.
import reviews from '../data/reviews.json';
import BrandIcon from './BrandIcon.astro';
import { homeNl as t } from '../i18n/home';
import { keepUnits } from '../lib/typo';

export interface Props { place: 'hero' | 'band' }
const { place } = Astro.props;

const rating = reviews.rating === null ? t.ratingPh : Number(reviews.rating).toLocaleString('nl-BE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const count = reviews.count === null ? t.countPh : String(reviews.count);

const icons = {
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  truck: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
};
const rows: { icon: keyof typeof icons | 'tgtg'; text: string }[] = [
  { icon: 'shield', text: t.trust.items[0] },
  { icon: 'clock', text: t.trust.items[1] },
  { icon: 'truck', text: t.trust.items[2] },
  { icon: 'tgtg', text: t.trust.items[3] },
];
---
<ul class:list={['trust', `trust--${place}`]} aria-label={t.trust.label}>
  <li>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
    <span>{t.trust.google(rating, count)}</span>
  </li>
  {rows.map((r) => (
    <li>
      {r.icon === 'tgtg'
        ? <BrandIcon name="too-good-to-go" size={16} />
        : <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[r.icon]} />}
      <span>{keepUnits(r.text)}</span>
    </li>
  ))}
</ul>

<style>
  .trust {
    list-style: none;
    margin: 0;
    color: var(--fg);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }
  .trust li { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .trust svg { flex: 0 0 auto; }

  /* phone: the band under the hero (board Main: padding 18 20, 2 × 1fr, gap 12 16, hairline below) */
  .trust--band {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    padding: 18px var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .trust--hero { display: none; }

  /* a short desktop screen: the band, in one row aligned to the 1440 container */
  @media (min-width: 960px) {
    .trust--band {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 28px;
      padding: 18px max(var(--gutter), calc((100% - var(--container)) / 2 + var(--gutter)));
    }
  }
  @media (min-width: 1200px) and (min-height: 760px) {
    .trust--band { display: none; }
    /* board Desktop: one row, gap 28, hairline above, padding-top 18; five items wrap to a second row
       in a narrow column */
    .trust--hero {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 28px;
      padding: 18px 0 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
