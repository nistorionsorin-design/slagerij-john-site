---
// Stamp badge. Text is slotted; none is baked in.
---
<span class="stamp">
  <span class="stamp__ring" aria-hidden="true"></span>
  <span class="stamp__text"><slot /></span>
</span>

<style>
  .stamp {
    display: inline-grid;
    place-items: center;
    width: 110px; height: 110px;
    position: relative;
    color: var(--ox);
    font-family: var(--f-display);
    font-weight: 600;
    text-align: center;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 11px;
    transform: rotate(-6deg);
  }
  .stamp__ring {
    position: absolute;
    inset: 0;
    border: 2px solid var(--ox);
    border-radius: 50%;
    box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--ox);
  }
  .stamp__text { padding: 0 14px; z-index: 1; }
</style>
