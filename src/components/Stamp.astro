---
// Stamp badge (brief §4). Text is slotted; none is baked in.
// paper: oxblood on paper, rotated −6° (board Toog).
// ink: paper rings on a dark ground, rotated 8°. It was the ring stamp on the desktop hero photo until
// stage 1c (hero-seam.css v1.5: the hero's stamp is now the inline ink SVG, design/svg/stamp.svg) — v1.5
// no longer sizes `.stamp`, so a dark-ground use (footer, stage 0c) sets its own size and padding.
export interface Props { variant?: 'paper' | 'ink'; class?: string }
const { variant = 'paper', class: cls } = Astro.props;
---
<span class:list={['stamp', `stamp--${variant}`, cls]}>
  <span class="stamp__text"><slot /></span>
</span>

<style>
  .stamp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-radius: 999px;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--f-ui);
  }
  .stamp--paper {
    width: 110px; height: 110px;
    padding: 14px;
    color: var(--ox);
    border: 2px solid var(--ox);
    box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--ox);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    transform: rotate(-6deg);
  }
  .stamp--ink {
    color: var(--on-ink);
    border: 2px solid var(--on-ink);
    font-size: 10px;
    font-weight: 700;
    transform: rotate(8deg);
  }
</style>
