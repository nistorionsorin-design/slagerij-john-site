---
// Stamp badge (brief §4). Text is slotted; none is baked in.
// paper: oxblood on paper, rotated −6° (board Toog).
// ink: on-ink ring on the dark hero panel, rotated 8°, 124 px (board Desktop).
export interface Props { variant?: 'paper' | 'ink' }
const { variant = 'paper' } = Astro.props;
---
<span class={`stamp stamp--${variant}`}>
  <span class="stamp__text"><slot /></span>
</span>

<style>
  .stamp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-radius: 999px;
    text-align: center;
    text-transform: uppercase;
    font-family: var(--f-ui);
  }
  .stamp--paper {
    width: 110px; height: 110px;
    padding: 14px;
    color: var(--ox);
    border: 2px solid var(--ox);
    box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--ox);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    transform: rotate(-6deg);
  }
  .stamp--ink {
    width: 124px; height: 124px;
    padding: 14px;
    color: var(--on-ink);
    border: 2px solid var(--on-ink);
    box-shadow: inset 0 0 0 5px rgba(21, 17, 13, .35), inset 0 0 0 6px var(--on-ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.35;
    transform: rotate(8deg);
  }
</style>
