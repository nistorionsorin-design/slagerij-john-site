---
// Open chip (stage 2, D-20 + addendum 07.10: treatment 2 „Segment”) — design/css/open-chip.css v1.1 ported 1:1
// (src/styles/open-chip.css: byte-identical above its marked additions line). One link to the hours card
// (#openingsuren, in the footer). Rendering contract of the file: the server renders the „still” state — today's
// hours from hours.json at build (Europe/Brussels) — and src/scripts/open-chip.ts upgrades the same element to the
// live state (computed in the browser from the hours inlined by Base.astro, every minute on the minute and when the
// tab comes back). The chip hugs its text (no reserved width): it sits on its own line or at the start of a
// space-between row, so a text change moves nothing else. Without JS the still text stays.
// Variants: p = on paper/card, i = on ink, im = on ink on the phone and on paper from 960 px (the home hero: dark
// photo on the phone, the paper column on desktop).
import '../styles/open-chip.css';
import hours from '../data/hours.json';
import { brussels, hoursOn, type HoursData } from '../lib/open-state';
import { chip, type Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
  variant?: 'p' | 'i' | 'im';
  class?: string;
}
const { locale, variant = 'p', class: extra } = Astro.props;
const h = hours as HoursData;
const { slots } = hoursOn(h, brussels(new Date(), h.timeZone).day);
const [state, time] = chip[locale].text({ kind: 'still', slots });
const look = variant === 'p' ? 'p' : 'i';
---
<a class:list={['oc', look, 'still', { 'oc--m': variant === 'im' }, extra]} href="#openingsuren" data-oc={locale}><span class="seg"><span class="d beat" aria-hidden="true"></span><span class="s">{state}</span></span><span class="t" hidden={!time}>{time}</span></a>

<script>
  import '../scripts/open-chip.ts';
</script>
