---
// Board — the counter board „Krijtbord” under a per-kg category's counter tags on /producten + /ro/produse (row 18b, D-47;
// Dan 13:25: C1a, the ink chalkboard). Look = design/css/board.css v1, ported 1:1 as src/styles/board.css (global, imported
// by the view); markup = that file's contract. Every name of the owners' counter list (products.json `board` rows) as one
// link into its bestelbon row (?product=<id>#n-<id>, the wheel cards' mechanism; the link carries the row's id, the
// ItemList's anchor); the pork board in two groups (Varken · Orgaanvlees); the line under it with the WhatsApp link.
// The title is an h4 here (the contract's h3): on this page the category's own heading is the h3, under the part's h2.
// The count (the live number of names on this board) is drawn, and read as words ("19 producten") from a hidden span —
// aria-label is not read on a plain span. No script, nothing moves.
import type { Product } from '../data/types';
import type { Locale } from '../i18n/ui';

export interface Props {
  /** the category id (board-rund …) */
  id: string;
  title: string;
  eyebrow: string;
  /** one group per list; `label` only when the board has more than one group */
  groups: { label?: string; items: Product[] }[];
  /** the count in words for screen readers */
  count: (n: number) => string;
  href: (id: string) => string;
  foot: string;
  wa: { label: string; href: string };
  locale: Locale;
}
const { id, title, eyebrow, groups, count, href, foot, wa, locale } = Astro.props;
const n = groups.reduce((a, g) => a + g.items.length, 0);
---
<section class="board" id={`board-${id}`} aria-labelledby={`board-${id}-title`}>
  <p class="board__eyebrow">{eyebrow}</p>
  <h4 class="board__title" id={`board-${id}-title`}><span>{title}</span><span class="board__count"><span aria-hidden="true">{n}</span><span class="vh">{count(n)}</span></span></h4>
  {groups.map((g) => (<>
    {g.label && <p class="board__group">{g.label}</p>}
    <ul class="board__list">
      {g.items.map((p) => <li><a id={p.id} href={href(p.id)}>{p.name[locale]}</a></li>)}
    </ul>
  </>))}
  <p class="board__foot">{foot} <a href={wa.href}>{wa.label}</a></p>
</section>
