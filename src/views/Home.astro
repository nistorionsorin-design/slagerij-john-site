---
// Home, NL (/) and RO (/ro, stage 9). Stage 1: the hero. Stage 3: the body — trust strip · „Deze week op de toog” ·
// category grid · Eindejaar · reviews · photo loop „Bij ons” · owners + hours card · FAQ (canvas boards Main + Raster;
// desktop derived, D-30). Title and description: lexicon §5.12, home NL (shortened 06.10) / home RO (59 / 148), verbatim.
// Body strings: src/i18n/home.ts (`homeNl` / `homeRo`, lexicon §6 „Acasă”). One view, two pages: src/pages/index.astro
// and src/pages/ro/index.astro.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HeroPreload from '../components/HeroPreload.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ToogWeek from '../components/ToogWeek.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import SeasonBlock from '../components/SeasonBlock.astro';
import Reviews from '../components/Reviews.astro';
import PhotoLoop from '../components/PhotoLoop.astro';
import Owners from '../components/Owners.astro';
import Hours from '../components/Hours.astro';
import Faq from '../components/Faq.astro';
import { homeT } from '../i18n/home';
import type { Locale } from '../i18n/ui';
import '../styles/sections.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = homeT[locale];
const alternates = { nl: '/', ro: '/ro' };
const meta = {
  nl: {
    title: 'Slagerij John – slager & traiteur in Zwevezele, zondag open',
    description: 'Slager & traiteur in Zwevezele: dagvers vlees, huisbereide gerechten, BBQ- en feestschotels, Roemeense specialiteiten. Zondag open. Bestel via WhatsApp.',
  },
  ro: {
    title: 'Măcelăria John – măcelărie și magazin românesc în Zwevezele',
    description: 'Mici și cârnați de casă, afumături, carne proaspătă zilnic, platouri pentru grătar. Lângă Tielt și Roeselare. Deschis duminica. Comandă pe WhatsApp.',
  },
}[locale];
---
<Base title={meta.title} description={meta.description} locale={locale} path={alternates[locale]} alternates={alternates} navVariant="hero" hoursCard>
  <HeroPreload slot="head" home />
  <main id="main">
    <Hero locale={locale}>
      <TrustStrip slot="trust" place="hero" locale={locale} />
    </Hero>
    <TrustStrip place="band" locale={locale} />
    <ToogWeek locale={locale} />
    <CategoryGrid locale={locale} />
    <SeasonBlock locale={locale} />
    <Reviews locale={locale} />
    <PhotoLoop locale={locale} />
    <div class="sec visit">
      <div class="container visit__in">
        <Owners locale={locale} />
        <Hours locale={locale} title={t.hours.title} closed={t.hours.closed} route={t.hours.route} />
      </div>
    </div>
    <Faq locale={locale} title={t.faq.title} />
  </main>
</Base>

<style>
  /* owners + hours: stacked on the phone (board Main: owners padding 24 20, the card below with 20 px margins),
     side by side on desktop */
  .visit { padding-top: 24px; }
  .visit__in { display: flex; flex-direction: column; gap: 24px; }
  @media (min-width: 960px) {
    .visit { padding-top: 80px; }
    .visit__in {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 56px;
      align-items: center;
    }
  }
</style>
