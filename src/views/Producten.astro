---
// /producten — Producten & prijzen (stage 4). Canvas board Producten (mobile 390) 1:1: intro (eyebrow · H1 + accent ·
// lead · open chip · WhatsApp · category pills) · photo · one section per category with its counter tags · the note ·
// the order card · FAQ · byline. Strings: lexicon §5.19 (NL) / §6 „Produse” + the D-33 RO line (RO, stage 9).
// One view, two pages: src/pages/producten.astro and src/pages/ro/produse.astro.
// The pills are a filter (§5.19, „Alles” by default) without a script (the CSP and the gate allow no page script):
// radio inputs, and `main:has(#f-x:checked)` hides the other sections; without :has every section stays visible.
// A section that is the URL's #target („Bekijk de colli's”) shows whatever the filter says.
// Desktop derived (D-30): intro left + photo right; each category = heading left, tags right (the home's „Deze week op
// de toog” pattern); the order card in two columns; FAQ = the home's component.
// Data: products.json (stage 4 shape; prices null → [PRIJS] until FACTS.md). Strings: src/i18n/producten.ts.
// JSON-LD: BreadcrumbList (lexicon §8.4) + one Product per tag (§8.3; the offer's price only once FACTS.md has it).
// Row 14 (16.10, Dan 15:35): the page photo is a frame loop that follows the chips (FrameLoop.astro, the hero's engine
// reused; photos.json `producten`: 8 frames + `by_chip`); it replaces the single photo (hero frame 2) and the varken
// section photo of 15:20.
// D-37 v3 (16.10, Dan 17:01 „b for sure”, 17:13 „the ones appearing on the right just change like the other photos,
// with Ken Burns”, 17:23 the chop as the ground; spec design/producten-hero.md): the page head is a dark print as on
// /traiteur — an ink band, full bleed, the bone-in chop (#46, cut out, laid horizontal, RGBA) as a wide slab across its
// right side, the spec's gradient darkening it only under the text column (it darkens, it does not desaturate), the
// text column over the left (strings unchanged), and over the right part of the chop one fixed slot that shows one
// product at a time (HeadSlot.astro: 43 → 42 → 40 → 30, the hero's frame engine). The chop zooms 1 → 1,04 over 30 s
// (alternate); one pause (the hero's control) holds the head and the frame loop below (FrameLoop `pauseFor`); reduced
// motion = still. The chop and product 1 are in the HTML at opacity 1, eager (D-12). The loop sits under the band: the
// phone's 190 px slot as before, a 3 : 1 print across the container from 960; its frame 1 waits for `load` on this page
// (`deferFirst`, Dan 16.10 after the first D-37 measurement: the head alone = LCP 2,6 s, with the loop's frame 1 2,9).
// D-37 v4 (16.10, Dan): no full-bleed band any more — the head IS /traiteur's head (src/styles/print-head.css: the
// contained print, radius, height, padding, type, buttons, gradient) with the chop as its ground and the slot in the
// print's right column; the chips stay inside it; the loop under it has the print's width.
// D-37 v4 §6 (16.10 21:26, Dan „take them out, they don't look good there, arrange them nicely down”): no slot in the
// head any more — text column + the chop ground only; the four cut-outs stand in a counter row right under the head
// (CounterRow.astro, same width, on the cream page), the loop below that.
// D-37 v5 §7 (16.10 21:40, Dan 21:36 „in cards like in Traiteur … take out the big one below”): the counter row and the
// chip-driven frame loop are gone (FrameLoop, its loader, the row; photos.json `producten` stays as data); under the
// head four tiles on /traiteur's tile (ProductTiles.astro + src/styles/tiles.css), each a link to its chip.
// D-37 v6 §8 (17.10, Dan 10:21 „the nice ken burns on the hero doesn't work”, 10:30–10:50): the head's ground is two
// frames — the chop and the top of the pork pile — in a 24 s CSS loop (12 s each, 1,4 s crossfade, a Ken Burns
// 1 → 1,14 with a small pan while each is up; ph-zoom 1 → 1,04 / 30 s is gone); the chop is the first frame and the LCP
// image, at opacity 1 from first paint; reduced motion = the chop, still. The tiles become the light tinted pop-out
// tiles B (ProductTiles.astro); tile 4 = Gerookte worst / Cârnați afumați; a line under them.
import { getImage } from 'astro:assets';
import ProductTiles from '../components/ProductTiles.astro';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import OpenChip from '../components/OpenChip.astro';
import CounterTag from '../components/CounterTag.astro';
import Faq from '../components/Faq.astro';
import WaIcon from '../components/WaIcon.astro';
import photos from '../data/photos.json';
import type { Product } from '../data/types';
import { products, priceLabel, unitLabel } from '../lib/price';
import { wa, hero, type Locale } from '../i18n/ui';
import { productenT } from '../i18n/producten';
import '../styles/sections.css';
import '../styles/print-head.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = productenT[locale];
const ro = locale === 'ro';
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/producten', ro: '/ro/produse' };
const path = alternates[locale];
const homePath = ro ? '/ro' : '/';
const waSrc = (pos: string) => (ro ? `ro-produse-${pos}` : `producten-${pos}`);

// the board's sections, in its order (§5.19 „Scope of this page”: everything sold by the kilo or the piece, colli's as a
// summary); BBQ & gourmet — priced per person — has its own page; its item stays in products.json for the home's tag
const onPage = ['rund', 'varken', 'kip', 'lam', 'roemeens', 'colli'];
const cats = onPage.map((id) => {
  const c = products.categories.find((x) => x.id === id);
  if (!c) throw new Error(`products.json: no category "${id}"`);
  return { ...c, items: products.items.filter((p) => p.category === id && !p.orderOnly) }; // orderOnly: bestelbon only (stage 5)
});

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/producten/*.{jpg,jpeg,png,webp}', { eager: true });

// the head (D-37 v3): photos.json `producten_head`
const headData = photos.producten_head as {
  ground: { src: string; alt: Record<Locale, string> };
  ground_b: { src: string; alt: Record<Locale, string> };
  tiles: { chip: string; src: string; alt: Record<Locale, string> }[];
};
const asset = (src: string) => {
  const m = files[`../assets/${src}`];
  if (!m) throw new Error(`photos.json producten_head: src/assets/${src} not found`);
  return m.default;
};
// the chop: alpha kept (sharp carries it into AVIF and WebP). Phone: drawn 150 % of the band's width, the LCP image —
// its own source, widths ≤ 1080 and sizes 100vw, so it is fetched at ⅔ of its drawn pixels (the slab lies under the
// gradient; ≤ 80 kB, spec §5: the 1440 variant Lighthouse's 412 × 1,75 asked for at sizes 150vw was 95 kB, LCP 3,2 / 3,8 s
// [MEASURED-OURS] local). From 960: a box from 35 % of the band to 6 % past its right edge, 115 % of its height, the
// chop covering it (≥ 840 px wide).
const chopImg = asset(headData.ground.src);
const chopSet = async (widths: number[]) => {
  const opts = { src: chopImg, width: chopImg.width, height: chopImg.height, widths: widths.filter((w) => w <= chopImg.width) };
  const [avif, webp] = await Promise.all([getImage({ ...opts, format: 'avif', quality: 40 }), getImage({ ...opts, format: 'webp', quality: 60 })]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
};
const [chopM, chopD] = await Promise.all([chopSet([640, 768, 1080]), chopSet([1080, 1440, chopImg.width])]);
const chop = { m: chopM, d: chopD, mSizes: '85vw', dSizes: 'max(71vw, 840px)', width: chopImg.width, height: chopImg.height, alt: headData.ground.alt[locale] };
// frame B (spec §8.1): the top of the pork pile (RGBA, its foot and left edge fade out in the file). A content frame
// with its own alt (row 14d, 19.10) — low priority, never the LCP: it waits in a <template> and the script below
// inserts it one painted frame after `load` (fetched before the chop's paint it cost 0,1 s of mobile LCP, 17.10
// [MEASURED-OURS] local); the loop goes live once it is decoded. Without JS, with reduced motion or Save-Data the head
// is the chop, still. Phone: drawn ≈ 96 % of the band (≤ 60 kB at
// Lighthouse's 412 × 1,75); from 960: object-fit contain in the chop's box, ≈ 48 % of the viewport wide.
const porkImg = asset(headData.ground_b.src);
const porkSet = async (widths: number[]) => {
  const opts = { src: porkImg, width: porkImg.width, height: porkImg.height, widths: widths.filter((w) => w <= porkImg.width) };
  const [avif, webp] = await Promise.all([getImage({ ...opts, format: 'avif', quality: 40 }), getImage({ ...opts, format: 'webp', quality: 60 })]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
};
const [porkM, porkD] = await Promise.all([porkSet([360, 540, 720]), porkSet([720, 1080, porkImg.width])]);
const pork = { m: porkM, d: porkD, mSizes: '96vw', dSizes: '48vw', width: porkImg.width, height: porkImg.height, alt: headData.ground_b.alt[locale] };
// the tiles under the head (spec §8.2): the four cut-outs in their order, the captions of lexicon §5.19 / §6 in the
// same order; the link = its chip's radio, its href the section it stands for (Alles →
// the list's first section)
const tiles = headData.tiles.map((x, i) => ({
  img: asset(x.src),
  alt: x.alt[locale],
  ...t.tiles.items[i],
  chip: `f-${x.chip}`,
  href: `#${x.chip === 'all' ? onPage[0] : x.chip}`,
}));

// JSON-LD (lexicon §8.3 / §8.4). The shop's @id is Base.astro's.
const shop = { '@id': `${origin}/#shop` };
const unitSpec = (p: Product) =>
  p.unit === 'kg'
    ? { unitCode: 'KGM', referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'KGM' } }
    : p.unit === 'pers'
      ? { unitCode: 'C62', unitText: ro ? 'de persoană' : 'per persoon' }
      : { unitText: p.unit };
const productLd = (p: Product, category: string) => {
  const price = p.price === null ? {} : { price: p.price.toFixed(2) };
  return {
    '@type': 'Product',
    '@id': `${origin}${path}#${p.id}`,
    name: p.name[locale],
    category,
    brand: { '@type': 'Brand', name: 'Slagerij John' },
    offers: {
      '@type': 'Offer',
      url: `${origin}${path}#${p.id}`,
      priceCurrency: 'EUR',
      ...price,
      priceSpecification: { '@type': 'UnitPriceSpecification', priceCurrency: 'EUR', ...price, ...unitSpec(p) },
      availableAtOrFrom: shop,
      seller: shop,
    },
  };
};
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  ...cats.flatMap((c) => c.items.map((p) => productLd(p, c.name[locale]))),
];

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld}>
  <main id="main" class="pp">
    <div class="th-wrap">
      <section class="th ph" aria-labelledby="pp-title">
        <div class="th__media ph__ground">
          <picture class="ph__chop"><source media="(min-width: 960px)" type="image/avif" srcset={chop.d.avif} sizes={chop.dSizes} /><source media="(min-width: 960px)" type="image/webp" srcset={chop.d.webp} sizes={chop.dSizes} /><source type="image/avif" srcset={chop.m.avif} sizes={chop.mSizes} /><img src={chop.m.src} srcset={chop.m.webp} sizes={chop.mSizes} width={chop.width} height={chop.height} alt={chop.alt} loading="eager" decoding="async" fetchpriority="high" /></picture>
          <template data-frames><picture class="ph__pork"><source media="(min-width: 960px)" type="image/avif" srcset={pork.d.avif} sizes={pork.dSizes} /><source media="(min-width: 960px)" type="image/webp" srcset={pork.d.webp} sizes={pork.dSizes} /><source type="image/avif" srcset={pork.m.avif} sizes={pork.mSizes} /><img src={pork.m.src} srcset={pork.m.webp} sizes={pork.mSizes} width={pork.width} height={pork.height} alt={pork.alt} loading="lazy" decoding="async" fetchpriority="low" /></picture></template>
        </div>
        <div class="th__title">
          <p class="eyebrow th__eyebrow">{t.eyebrow}</p>
          <h1 class="th__h1" id="pp-title">{t.h1} <span class="accent th__accent">{t.accent}</span></h1>
        </div>
        <div class="th__body on-ink">
          <p class="th__lead">{t.lead}</p>
          <div class="pp-intro__row">
            <OpenChip locale={locale} variant="i" class="pp-intro__chip" />
            {/* the page's one pause (WCAG 2.2.2): both head frames; the hero's control, CSS :has */}
            <span class="ph__pause">
              <input type="checkbox" id="pp-pause" class="hp hp--page" data-pause />
              <label for="pp-pause" class="btn-icon">
                <span class="vh ph__say-pause">{hero[locale].pause}</span>
                <span class="vh ph__say-play">{hero[locale].play}</span>
                <svg class="ic-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                <svg class="ic-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>
              </label>
            </span>
          </div>
          <div class="th__buttons">
            <a class="btn btn--primary btn--lg" href={wa(waSrc('intro'))}><WaIcon /><span>{t.order}</span></a>
            <a class="btn btn--secondary btn--lg" href={t.onlineHref}>{t.online}</a>
          </div>
          <fieldset class="pp-pills">
            <legend class="vh">{t.filter.legend}</legend>
            <input class="pp-pills__in" type="radio" name="pp-filter" id="f-all" checked />
            <label class="pp-pill" for="f-all">{t.filter.all}</label>
            {cats.map((c) => (
              <>
                <input class="pp-pills__in" type="radio" name="pp-filter" id={`f-${c.id}`} />
                <label class="pp-pill" for={`f-${c.id}`}>{c.name[locale]}</label>
              </>
            ))}
          </fieldset>
        </div>
      </section>
    </div>

    <div class="container pp-tiles">
      <ProductTiles tiles={tiles} label={t.tiles.label} line={t.tiles.line} id="pp-tiles-title" />
    </div>

    {cats.map((c) => {
      const isRo = c.id === 'roemeens';
      const colli = c.id === 'colli';
      return (
        <section class="pp-cat" id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="container pp-cat__in">
            <div class="pp-cat__head">
              {isRo && t.roemeens.eyebrow && <p class="eyebrow">{t.roemeens.eyebrow}</p>}
              <h2 class="pp-cat__title" id={`${c.id}-title`}>{isRo ? t.roemeens.title : colli ? t.colli.title : c.name[locale]}</h2>
            </div>
            <ul class="pp-cat__tags">
              {c.items.map((p) => (
                <li><CounterTag id={p.id} thumb={p.id} locale={locale} name={p.name[locale]} line={p.line?.[locale]} price={priceLabel(p, locale)} unit={unitLabel(p.unit, locale)} tone={p.featured ? 'ink' : 'paper'} /></li>
              ))}
            </ul>
            {isRo && t.roemeens.roHref && <a class="pp-cat__more" href={t.roemeens.roHref} lang="ro" hreflang="ro">{t.roemeens.roLabel}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>}
          </div>
        </section>
      );
    })}

    <div class="container pp-note">
      <p>{t.note}</p>
    </div>

    <section class="container pp-order" aria-labelledby="pp-order-title">
      <div class="pp-card">
        <div class="pp-card__text">
          <h2 class="pp-card__title" id="pp-order-title">{t.card.title}</h2>
          <p class="pp-card__p">{t.card.pickup}</p>
          <p class="pp-card__p">{t.card.minimum}</p>
          <p class="pp-card__p">{t.card.delivery}</p>
          <p class="pp-card__p pp-card__p--muted">{t.card.pay}</p>
        </div>
        <div class="pp-card__act">
          <div class="pp-card__msg">
            <p class="pp-card__label">{t.card.msgLabel}</p>
            <p class="pp-card__text-msg">{t.card.msg}</p>
          </div>
          <a class="btn btn--primary btn--lg btn--block" href={wa(waSrc('card'))}><WaIcon /><span>{t.card.cta}</span></a>
          <a class="btn btn--secondary btn--lg btn--block" href={t.card.secondaryHref}>{t.card.secondary}</a>
        </div>
      </div>
    </section>

    <Faq locale={locale} title={t.faq} page="producten" />

    <div class="container pp-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<script>
  // the head's frame B (spec §8.1): inserted one painted frame after `load`, the loop live once it is decoded
  import { afterLoadPaint, insertFrames, reducedMotion, saveData, whenDecoded } from '../scripts/frames';
  const head = document.querySelector<HTMLElement>('.ph');
  const ground = head?.querySelector<HTMLElement>('.ph__ground');
  afterLoadPaint(() => {
    if (!head || !ground || reducedMotion() || saveData() || !insertFrames(ground)) return;
    whenDecoded(ground.querySelector<HTMLImageElement>('.ph__pork img'), () => head.classList.add('is-live'));
  });
</script>

<style>
  /* ── phone = board Producten (390) ── */
  /* the head (D-37 v3; v4, Dan 16.10: „it is that head component with a different ground and the product slot”):
     /traiteur's head — src/styles/print-head.css gives the box, the type, the buttons and, from 960, the print and its
     gradient — with the chop as its ground (.th__media). The ground sits at z −1 under everything in the head
     (isolation), so the text needs no z-index of its own. */
  .ph { isolation: isolate; }
  .ph__ground { z-index: -1; }
  .ph__chop, .ph__pork { position: absolute; display: block; }
  .ph__chop img, .ph__pork img { display: block; width: 100%; }
  .ph__chop img { transform-origin: 80% 55%; }
  .ph__pork img { transform-origin: 60% 20%; }
  /* frame B waits, unseen, until the loop brings it in; reduced motion never shows it (the chop, still) */
  .ph__pork { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .ph__pork { display: none; } }
  /* phone: one ink band, full bleed as /traiteur's phone head (spec §2–3); the chop (alpha) as a wide slab across the
     lower part of the band (150 % of its width, its foot just below the band's), and over it the spec's top→bottom
     gradient, whose .90 stop sits where the text ends (the band's last 104 px are its padding), so the whole text
     column — chips included — stands on ≥ .90 ink while the strip of chop under the chips stays bright (.35 → its
     foot). No saturate. */
  @media (max-width: 959.98px) {
    .ph { position: relative; display: flex; flex-direction: column; gap: 14px; overflow: hidden; padding: 24px var(--gutter) 104px; background: var(--ink); color: var(--on-ink); }
    .ph__ground { position: absolute; inset: 0; overflow: hidden; }
    .ph__chop { left: -25%; right: -25%; bottom: -4%; }
    .ph__chop img, .ph__pork img { height: auto; }
    /* the pork: the right of the band, its faded foot running out of the bottom, so the meat fills the bright strip */
    .ph__pork { right: -18%; width: 96%; bottom: -80px; }
    .ph__ground::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(21, 17, 13, 0.97) 0%, rgba(21, 17, 13, 0.9) max(45%, calc(100% - 104px)), rgba(21, 17, 13, 0.35) 100%);
    }
    .ph .th__lead { color: var(--on-ink-muted); }
  }
  /* the hero's row: the open chip, the pause at its right */
  .pp-intro__row { display: flex; align-items: center; gap: 12px; }

  /* the chips, dark variant (board B): cream hairline on ink, the chosen one cream with ink text. On the phone they stay
     inside the band: there the ink is ≥ .90; below them it thins to .35 over the bright chop */
  .pp-pills { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  /* the radio stays in the tab order (arrow keys move the choice); the label is what you see */
  .pp-pills__in { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .pp-pill {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 14px;
    border-radius: var(--r-chip);
    border: 1px solid rgba(244, 237, 224, 0.4);
    background: rgba(21, 17, 13, 0.35);
    color: var(--on-ink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  .pp-pills__in:checked + .pp-pill { background: var(--paper); border-color: var(--paper); color: var(--fg); }
  .pp-pills__in:focus-visible + .pp-pill { outline: 2px solid var(--on-ink); outline-offset: 2px; }
  @media (hover: hover) { .pp-pills__in:not(:checked) + .pp-pill:hover { border-color: var(--on-ink); } }

  /* motion (spec §8.1): a 24 s loop, linear opacity — each frame up 12 s with a 1,4 s crossfade — and on the visible
     part a Ken Burns 1 → 1,14 with a small pan, held to the end of the cycle so the reset happens while the frame is
     unseen. The chop runs 1,44 s (6 %) ahead, so the loop starts from it fully up — the still it shows from first paint
     (D-12); the pork runs the same keyframes half a cycle later. The loop runs once .is-live is set (frame B inserted
     and decoded, script below). */
  @keyframes ph-fade { 0% { opacity: 0; } 6% { opacity: 1; } 50% { opacity: 1; } 56% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes ph-kb {
    0% { transform: scale(1) translate(0, 0); }
    56%, 100% { transform: scale(1.14) translate(-2.5%, 1.5%); }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* each delay inside its own shorthand: Astro's scoping changes the selectors' weight, a separate delay rule lost */
    .ph.is-live .ph__chop { animation: ph-fade 24s linear -1.44s infinite; }
    .ph.is-live .ph__pork { animation: ph-fade 24s linear -13.44s infinite; }
    .ph.is-live .ph__chop img { animation: ph-kb 24s ease-in-out -1.44s infinite; will-change: transform; }
    .ph.is-live .ph__pork img { animation: ph-kb 24s ease-in-out -13.44s infinite; will-change: transform; }
  }

  /* the pause: the hero's control (CSS only); it holds both head frames (the tiles no longer move, spec §8.2) */
  .ph__pause { position: relative; margin-left: auto; display: inline-flex; }
  .ph .hp { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .ph:has(.hp:checked) :is(.ph__chop, .ph__pork, .ph__chop img, .ph__pork img) { animation-play-state: paused; }
  .ph .ic-play { display: none; }
  .ph:has(.hp:checked) .ic-pause { display: none; }
  .ph:has(.hp:checked) .ic-play { display: block; }
  .ph .hp:focus-visible + label { outline: 2px solid var(--on-ink); outline-offset: 2px; }
  .ph__say-play { display: none; }
  .ph:has(.hp:checked) .ph__say-pause { display: none; }
