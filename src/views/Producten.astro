---
// /producten — Producten & prijzen (stage 4). Canvas board Producten (mobile 390) 1:1: intro (eyebrow · H1 + accent ·
// lead · open chip · WhatsApp · category pills) · photo · one section per category with its counter tags · the note ·
// the order card · FAQ · byline. Strings: lexicon §5.19 (NL) / §6 „Produse” + the D-33 RO line (RO, stage 9).
// One view, two pages: src/pages/producten.astro and src/pages/ro/produse.astro.
// Desktop derived (D-30): each category = heading left, tags right (the home's „Deze week op de toog” pattern); the
// order card in two columns; FAQ = the home's component.
// Data: products.json. Strings: src/i18n/producten.ts.
// JSON-LD: BreadcrumbList (lexicon §8.4) + one Product per row (§8.3; an Offer only where a price shows).
// History of the head (D-37 v3 … v6, row 14e): the head is the home's hero (PageHero.astro) — the chop and the pork top
// full screen on the phone, the sign over them, the home's scrim, the text, chip, pause and buttons at the foot; the two
// frames crossfade on the home's rhythm (9 s a frame, the home's Ken Burns 1 → 1,08). Under it the four tiles B
// (ProductTiles.astro, D-37 v6) and their line.
// Row 18 (20.10, D-41 · D-42 · D-44; lexicon §5.19 „20.10 — the whole assortment” + §6 „Produse, 20.10”; Dan's pick A3
// „Wiel”, design/css/assortment.css v1 ported 1:1 as src/styles/assortment.css): the page is the whole assortment, all
// 75 rows of products.json, in two parts on one page —
//   · hero + tiles + their line, unchanged;
//   · the sticky pill row (AsPills.astro: ten anchors, the scroll-spy; the stage-4 radio filter, its :has rules and
//     „Alles” are gone — every section stays visible);
//   · part 1 „Aan de toog” (head + the five per-kg sections, the 15 counter tags exactly as before; the §5.30 note moves
//     up into the head's line, nothing under the grid);
//   · part 2 „Feest & traiteur” (head + five rubric cards on paper: colli · gourmet · tapas · warm · dessert = the 60
//     other rows in file order, `orderOnly` included). Each rubric is a sideways wheel of cards on the phone and a
//     wrapping grid from 960; a card = the row's own item photo (D-34, 140 px) or an empty paper box of the same size ·
//     name · line · price + unit · „Bestel”, the whole card one link to its bestelbon row (/bestellen?product=<id>#n-<id>,
//     order.ts fills the quantity). The rubric head's print = the rubric's `level: section` photo, never on a card.
//   · order block, FAQ (six items), byline — the order block unchanged.
// Row 10d (20.10, lexicon §5.28 link swaps): the order block's secondary and the colli rubric's line („Alle colli's en
// vleespakketten”, its link alone) → /colli-vleespakketten · /ro/colli; the six colli stay rows here (D-43).
// The pill row needs one parent that holds all ten sections (sticky stays inside its parent), so the parts share one
// `.container` and the per-kg sections lost their own.
// JSON-LD (row 18): one ItemList (`…#assortiment` / `…#sortiment`, numberOfItems 75, ListItem → the Product @id, url = the
// row's anchor on this page) + the 75 Products; an Offer only where a price shows (S-03, D-39: „prijs in de winkel” has
// none); the BBQ line under the gourmet rubric is text, no node.
// Row 21 (23.10, D-50 (1)(2); lexicon §5.19 „23.10” + §6 „Produse, 23.10”): the owners' 22.10 lists — kip, lam and
// roemeens get their Krijtbord under the tags, and three board-only sections follow Lam (bereidingen · marinades ·
// charcuterie: no tags, no tiles; their pills after Lam); a board's groups = src/lib/board.ts (one group → no label);
// the volume-discount band once under part 1's head, its sentence in every board's foot (strings only, nothing
// computed, no price). JSON-LD: numberOfItems = the live count, the ListItem carries `item.@id` only (no `url`: the
// Rich Results Test reads `item` + `url` on one ListItem as invalid, lexicon §5.19 amended 23.10), the new rows join as
// name-only Products (S-03, D-39); the §8.2 WebPage node with dateModified = the byline's date (P-15).
import ProductTiles from '../components/ProductTiles.astro';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreload from '../components/HeroPreload.astro';
import CounterTag from '../components/CounterTag.astro';
import AsPills from '../components/AsPills.astro';
import Board from '../components/Board.astro';
import Thumb from '../components/Thumb.astro';
import Faq from '../components/Faq.astro';
import WaIcon from '../components/WaIcon.astro';
import photos from '../data/photos.json';
import type { Product } from '../data/types';
import { products, priceLabel, priceUnitLabel } from '../lib/price';
import { thumbOf } from '../lib/thumbs';
import { boardGroups } from '../lib/board';
import { keepUnits } from '../lib/typo';
import { ASSORTMENT_UPDATED } from '../lib/updated';
import { wa, type Locale } from '../i18n/ui';
import { productenT } from '../i18n/producten';
import { receptenT } from '../i18n/recepten';
import recipes from '../data/recipes.json';
import '../styles/sections.css';
import '../styles/assortment.css';
import '../styles/board.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = productenT[locale];
const ro = locale === 'ro';
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/producten', ro: '/ro/produse' };
const path = alternates[locale];
const homePath = ro ? '/ro' : '/';
const waSrc = (pos: string) => (ro ? `ro-produse-${pos}` : `producten-${pos}`);

// part 1 „Aan de toog”: the per-kg sections, the counter tags as before (row 21: the three board-only sections after
// Lam); part 2 „Feest & traiteur”: the five rubrics
const part1 = ['rund', 'varken', 'kip', 'lam', 'bereidingen', 'marinades', 'charcuterie', 'roemeens'];
const part2 = ['colli', 'gourmet', 'tapas', 'warm', 'dessert'] as const;
const rowsOf = (id: string) => products.items.filter((p) => p.category === id); // file order, orderOnly included
// row 18b (D-47): a category's `board` rows (the owners' counter list) are not tags — they make its Krijtbord under the
// tags, in groups (the pork board: Varken · Orgaanvlees; row 21: src/lib/board.ts)
const cats = part1.map((id) => {
  const c = products.categories.find((x) => x.id === id);
  if (!c) throw new Error(`products.json: no category "${id}"`);
  const board = rowsOf(id).filter((p) => p.board);
  return { ...c, items: rowsOf(id).filter((p) => !p.board), board, boardGroups: boardGroups(id, locale) };
});
const rubs = part2.map((id) => {
  const items = rowsOf(id);
  // the rubric head's print: the first `level: section` photo of the rubric (lexicon §5.19 20.10; colli: none)
  const print = items.find((p) => thumbOf(p.id)?.level === 'section')?.id;
  return { id, ...t.rubrics[id], items, print };
});
// every row of products.json is on the page, once
const onPage = [...part1, ...part2];
const missing = products.items.filter((p) => !onPage.includes(p.category));
if (missing.length) throw new Error(`products.json: rows outside the page's sections: ${missing.map((p) => p.id).join(', ')}`);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/producten/*.{jpg,jpeg,png,webp}', { eager: true });

// the head (D-37 v3): photos.json `producten_head`
const headData = photos.producten_head as {
  ground: { src: string; alt: Record<Locale, string> };
  ground_b: { src: string; alt: Record<Locale, string> };
  tiles: { chip: string; src: string; alt: Record<Locale, string> }[];
};
const asset = (src: string) => {
  const m = files[`../assets/${src}`];
  if (!m) throw new Error(`photos.json producten_head: src/assets/${src} not found`);
  return m.default;
};
// the hero's two frames (row 14e): the chop (#46, cut out, RGBA — the alpha shows the hero's ink) is frame 1 and the LCP
// image; the top of the pork pile (frame B of D-37 v6, a content frame with its own alt, row 14d) fades in over it.
// The zoom keeps each frame's old origin (the chop's bone end, the crown of the pile). Both drawn whole (Dan 19.10 „vers
// vlees, it has too much zoom”): the whole chop and the whole pile on the hero's ink, as wide as the phone, under the sign
// (PageHero `whole`; cut-outs, so no backdrop). AVIF quality 40 as the other heads: Lighthouse's simulation counts the
// high-priority frame 1 into the text LCP (the H1 is the LCP element here) — the cut 723 px phone file was 72 kB at q40
// (LCP 2,8 / 2,8 s), 47 kB at q30 (2,6 / 2,6 s); the whole chop at 828 px is 36 kB at q40, LCP 2,6 / 2,6 s (row 14e [MEASURED-OURS] local).
const heroFrames = [
  { img: asset(headData.ground.src), alt: headData.ground.alt[locale], focalX: 50, focalY: 50, zoomX: 80, zoomY: 55, whole: { width: 100, top: 8 } },
  { img: asset(headData.ground_b.src), alt: headData.ground_b.alt[locale], focalX: 50, focalY: 30, zoomX: 60, zoomY: 20, whole: { width: 96, top: 8 } },
];
// spec §4: the lead goes under the hero when the text block covers more of it than the home's own (64,6 % at 390 × 844,
// measured from the block's top — the chip row — to the hero's foot) — row 14e: 60,5 % NL / 65,5 % RO, it stayed; row 18's
// lead (one line longer in NL, the same lines in RO) at 390 × 844: 62,9 % NL / 65,5 % RO — it stays (row 18 [MEASURED-OURS]
// local, 20.10, the same script reading production's 60,5 / 65,5 first)
const LEAD_BELOW = false;
// the tiles under the head (spec §8.2): the four cut-outs in their order, the captions of lexicon §5.19 / §6 in the
// same order; each tile links to the section it stands for (all four: #roemeens)
const tiles = headData.tiles.map((x, i) => ({
  img: asset(x.src),
  alt: x.alt[locale],
  ...t.tiles.items[i],
  href: `#${x.chip === 'all' ? part1[0] : x.chip}`,
}));

// JSON-LD (lexicon §8.3 / §8.4 + the row-18 ItemList). The shop's @id is Base.astro's.
const shop = { '@id': `${origin}/#shop` };
const rowId = (p: Product) => `${origin}${path}#${p.id}`;
const unitSpec = (p: Product) =>
  p.unit === 'kg'
    ? { unitCode: 'KGM', referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'KGM' } }
    : p.unit === 'pers'
      ? { unitCode: 'C62', unitText: ro ? 'de persoană' : 'per persoon' }
      : { unitText: p.unit };
// row 15 (lexicon §5.30): a row without a price — „prijs in de winkel” (priceInStore) — carries no Offer (S-03)
const productLd = (p: Product, category: string) => {
  const price = p.price === null || p.priceInStore ? null : { price: p.price.toFixed(2) };
  return {
    '@type': 'Product',
    '@id': rowId(p),
    name: p.name[locale],
    category,
    brand: { '@type': 'Brand', name: 'Slagerij John' },
    ...(price && {
      offers: {
        '@type': 'Offer',
        url: rowId(p),
        priceCurrency: 'EUR',
        ...price,
        priceSpecification: { '@type': 'UnitPriceSpecification', priceCurrency: 'EUR', ...price, ...unitSpec(p) },
        availableAtOrFrom: shop,
        seller: shop,
      },
    }),
  };
};
// in page order: each category's tags, then its board names (row 18b: name-only Products, no Offer — priceInStore)
const rows = [
  ...cats.flatMap((c) => [...c.items, ...c.boardGroups.flatMap((g) => g.items)].map((p) => ({ p, category: c.name[locale] }))),
  ...rubs.flatMap((r) => r.items.map((p) => ({ p, category: r.name }))),
];
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${origin}${path}#webpage`,
    url: `${origin}${path}`,
    name: t.title,
    description: t.description,
    inLanguage: ro ? 'ro-BE' : 'nl-BE',
    isPartOf: { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: 'Slagerij John' },
    about: shop,
    dateModified: ASSORTMENT_UPDATED,
  },
  {
    '@type': 'ItemList',
    '@id': `${origin}${path}#${ro ? 'sortiment' : 'assortiment'}`,
    name: t.crumbs.page,
    numberOfItems: rows.length,
    itemListElement: rows.map(({ p }, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@id': rowId(p) } })),
  },
  ...rows.map(({ p, category }) => productLd(p, category)),
];

// row 17 (lexicon §5.29): a tag whose product has a recipe links to its card on /recepten
const withRecipe = new Set(recipes.recipes.map((r) => r.id));
const rt = receptenT[locale];
const recipesPath = ro ? '/ro/retete' : '/recepten';

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld} navVariant="hero">
  <HeroPreload slot="head" frame={heroFrames[0]} quality={40} />
  <main id="main" class="pp">
    <PageHero locale={locale} id="pp-title" eyebrow={t.eyebrow} h1={t.h1} accent={t.accent} lead={t.lead} leadBelow={LEAD_BELOW} chip frames={heroFrames} quality={40}>
      <a class="btn btn--primary btn--lg" href={wa(waSrc('intro'))}><WaIcon /><span>{t.order}</span></a>
      <a class="btn btn--secondary btn--lg" href={t.onlineHref}>{t.online}</a>
    </PageHero>

    <div class="container pp-tiles">
      <ProductTiles tiles={tiles} label={t.tiles.label} line={t.tiles.line} id="pp-tiles-title" />
    </div>

    {/* row 18: the pill row and both parts in one parent (the row sticks inside it) */}
    <div class="container pp-as">
      <AsPills label={t.pills.label} items={t.pills.items} />

      <section class="as-part" id="toog" aria-labelledby="toog-title">
        <p class="as-part__eyebrow">{t.toog.eyebrow}</p>
        <h2 class="as-part__title" id="toog-title">{t.toog.title}</h2>
        <p class="as-part__line">{t.toog.line}</p>
      </section>

      {/* row 21 (D-50 (2)): the volume discount, once, above the categories — canvas board Vitrine (the „kg” disc is a
          drawing, hidden from screen readers) */}
      <div class="pp-disc">
        <span class="pp-disc__kg" aria-hidden="true">kg</span>
        <div class="pp-disc__text">
          <p class="pp-disc__eyebrow">{t.discount.eyebrow}</p>
          <p class="pp-disc__p">{t.discount.text.map((s, i) => (i % 2 ? <strong>{keepUnits(s)}</strong> : keepUnits(s)))}</p>
        </div>
      </div>

      {cats.map((c) => {
        const isRo = c.id === 'roemeens';
        return (
          <section class="pp-cat as-target" id={c.id} aria-labelledby={`${c.id}-title`}>
            <div class="pp-cat__in">
              <div class="pp-cat__head">
                {isRo && t.roemeens.eyebrow && <p class="eyebrow">{t.roemeens.eyebrow}</p>}
                <h3 class="pp-cat__title" id={`${c.id}-title`}>{isRo ? t.roemeens.title : c.name[locale]}</h3>
              </div>
              {/* row 21: the three new categories are board only — no tag list */}
              {c.items.length > 0 && <ul class="pp-cat__tags">
                {c.items.map((p) => (
                  <li><CounterTag as="h4" id={p.id} thumb={p.id} locale={locale} name={p.name[locale]} line={p.line?.[locale]} price={priceLabel(p, locale)} unit={priceUnitLabel(p, locale) || undefined} tone={p.featured ? 'ink' : 'paper'} recipe={withRecipe.has(p.id) ? { href: `${recipesPath}#${p.id}`, label: rt.tagLink } : undefined} /></li>
                ))}
              </ul>}
              {c.board.length > 0 && <Board id={c.id} title={c.name[locale]} eyebrow={t.board.eyebrow} groups={c.boardGroups} count={t.card.count} href={t.card.href} foot={keepUnits(t.board.foot)} wa={{ label: t.board.wa, href: wa(waSrc('board')) }} locale={locale} />}
              {isRo && t.roemeens.roHref && <a class="pp-cat__more" href={t.roemeens.roHref} lang="ro" hreflang="ro">{t.roemeens.roLabel}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>}
            </div>
          </section>
        );
      })}

      <section class="as-part" id="feest" aria-labelledby="feest-title">
        <p class="as-part__eyebrow">{t.feest.eyebrow}</p>
        <h2 class="as-part__title" id="feest-title">{t.feest.title}</h2>
        <p class="as-part__line">{t.feest.line}</p>
      </section>

      <div class="as-rubs">
        {rubs.map((r) => (
          <section class="rub" id={r.id} aria-labelledby={`rub-${r.id}`}>
            <div class="rub__head">
              {r.print && <span class="rub__print"><Thumb id={r.print} locale={locale} variant="print" /></span>}
              <h3 class="rub__title" id={`rub-${r.id}`}><span class="rub__name">{r.name}</span><span class="rub__note">{r.note}</span></h3>
              <span class="rub__count"><span aria-hidden="true">{r.items.length}</span><span class="vh">{t.card.count(r.items.length)}</span></span>
            </div>
            <div class="wheel">
              {r.items.map((p) => {
                const own = thumbOf(p.id)?.level === 'item';
                const line = p.line?.[locale];
                return (
                  <a class="card" id={p.id} href={t.card.href(p.id)}>
                    {own ? <span class="card__img"><Thumb id={p.id} locale={locale} variant="card" /></span> : <span class="card__img card__img--none" aria-hidden="true"></span>}
                    <span class="card__name">{p.name[locale]}</span>
                    {line && <span class="card__line">{keepUnits(line)}</span>}
                    <span class="card__price">
                      {p.priceInStore
                        ? <span class="card__p card__p--state">{priceLabel(p, locale)}</span>
                        : <><span class="card__p">{priceLabel(p, locale)}</span><span class="card__u">{priceUnitLabel(p, locale)}</span></>}
                    </span>
                    <span class="card__btn">{t.card.action}</span>
                  </a>
                );
              })}
            </div>
            <p class="wheel__hint" aria-hidden="true">{t.card.hint}</p>
            {'more' in r && <p class="rub__under">{'under' in r && <>{r.under} </>}<a href={r.more.href}>{r.more.label}</a></p>}
          </section>
        ))}
      </div>
    </div>

    <section class="container pp-order" aria-labelledby="pp-order-title">
      <div class="pp-card">
        <div class="pp-card__text">
          <h2 class="pp-card__title" id="pp-order-title">{t.orderCard.title}</h2>
          <p class="pp-card__p">{t.orderCard.pickup}</p>
          <p class="pp-card__p">{t.orderCard.minimum}</p>
          <p class="pp-card__p">{t.orderCard.delivery}</p>
          <p class="pp-card__p pp-card__p--muted">{t.orderCard.pay}</p>
        </div>
        <div class="pp-card__act">
          <div class="pp-card__msg">
            <p class="pp-card__label">{t.orderCard.msgLabel}</p>
            <p class="pp-card__text-msg">{t.orderCard.msg}</p>
          </div>
          <a class="btn btn--primary btn--lg btn--block" href={wa(waSrc('card'))}><WaIcon /><span>{t.orderCard.cta}</span></a>
          <a class="btn btn--secondary btn--lg btn--block" href={t.orderCard.secondaryHref}>{t.orderCard.secondary}</a>
        </div>
      </div>
    </section>

    <Faq locale={locale} title={t.faq} page="producten" />

    <div class="container pp-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<script>
  // the hero's frame 2 (row 14e): PageHero's loop driver, inserted after `load`, live once decoded
  import '../scripts/page-hero.ts';
</script>

<style>
  /* ── phone = board Producten (390); the hero: PageHero.astro (row 14e); the pill row, the part heads and the rubric
     wheels: src/styles/assortment.css (row 18, ported 1:1) ── */

  /* the tiles (spec §7): the first row under the hero */
  .pp-tiles { padding-top: 20px; }

  /* row 18: the parts' common parent — the pill row sticks inside it */
  .pp-as { padding-top: 20px; }
  /* the card photo and the rubric print come from Thumb.astro as a <picture>: it fills the box assortment.css draws */
  .card__img :global(picture), .rub__print :global(picture) { display: block; width: 100%; height: 100%; }

  /* row 21 (D-50 (2)): the volume-discount band under part 1's head — canvas board Vitrine: a card, the accent disc with
     „kg”, the oxblood eyebrow, one sentence with its two figures in bold; as wide as its sentence (the phone: the row) */
  .pp-disc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-tile);
    background: var(--card);
  }
  .pp-disc__kg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--fg);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
  }
  .pp-disc__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pp-disc__eyebrow { margin: 0; font-size: var(--fs-eyebrow); font-weight: 600; letter-spacing: 0.14em; line-height: 1.3; text-transform: uppercase; color: var(--ox); }
  .pp-disc__p { margin: 0; font-size: 14px; line-height: 1.35; color: var(--fg); }

  .pp-cat { padding: 28px 0 8px; }
  .pp-cat__in { display: flex; flex-direction: column; gap: 14px; }
  .pp-cat__head { display: flex; flex-direction: column; gap: 14px; }
  .pp-cat__title { margin: 0; font-size: 26px; line-height: 1.05; letter-spacing: -0.015em; }
  .pp-cat__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .pp-cat__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch);
    font-size: 14px;
    font-weight: 600;
    color: var(--ox);
    text-decoration: none;
  }
  .pp-cat__more svg { width: 16px; height: 16px; }
  @media (hover: hover) { .pp-cat__more:hover { color: var(--fg); } }

  .pp-order { padding-top: 32px; }
  .pp-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-tile);
    background: var(--card);
  }
  .pp-card__text, .pp-card__act { display: flex; flex-direction: column; gap: 12px; }
  .pp-card__title { margin: 0; font-size: 22px; line-height: 1.1; }
  .pp-card__p { margin: 0; font-size: 14px; line-height: 1.45; color: var(--fg); }
