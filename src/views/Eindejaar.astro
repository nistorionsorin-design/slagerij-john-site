---
// /feestmenu-eindejaar — Eindejaarsmenu 2026 (stage 7). Canvas board Eindejaar (mobile 390) is the concept (D-30), its
// sections in order: the dark head, text only (eyebrow · H1 · accent · lead · two buttons) · the photo band (q19) ·
// three steps · the menu card (#feestmenu, oxblood) · the „Și în română” box · the holiday hours card · FAQ · byline.
// Row 14e (19.10, design/heroes-unify.md): q19 becomes the hero photo (PageHero.astro, the home's hero) and the band
// under the head goes — the photo full screen on the phone, the sign over it, the text and both buttons at its foot.
// Desktop derived (D-30): the hero full bleed, text left; below, the steps, the RO box and the holiday hours left, the
// menu card right.
// Strings: src/i18n/eindejaar.ts (lexicon §5.22). Menu card (row 15a, 13.10): the owners' folder's eight sections in
// its order + row 15d's ninth, ro-feest (prices in the shop: no Offer, ever), each row name · line · price + unit, then the owners' line. Row 15b (D-35): the look is
// src/styles/menu-card.css (the printed menu card) — the rubric index under the title, the price and its unit apart. Menu rows, deadline, pickup hours: menus.json (src/lib/menu.ts swaps
// a set value into [DATUM] / [UUR]); holiday rows: hours.json `special`. FAQ: the three §5.11 „Eindejaar” items
// (faq.json pages.eindejaar). No script on this page: the deadline is text only (build plan row 7).
// JSON-LD (§5.22): BreadcrumbList (§8.4) + WebPage (§8.2) about the shop's @id — no Event for the folder (§8.6), no
// Offer while a price is [PRIJS] (S-03); at stage 15 the rows become §8.3 Product + Offer with validThrough.
// RO (/ro/sarbatori, stage 9): lexicon §6 „Sărbători” (`eindejaarRo`) — no „Și în română” box, the extra row Porc de
// Crăciun; one view, two pages: src/pages/feestmenu-eindejaar.astro and src/pages/ro/sarbatori.astro.
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreload from '../components/HeroPreload.astro';
import WaIcon from '../components/WaIcon.astro';
import Faq from '../components/Faq.astro';
import Thumb from '../components/Thumb.astro';
import { thumbOf } from '../lib/thumbs';
import photos from '../data/photos.json';
import hours from '../data/hours.json';
import type { MenuItem, Photo, SpecialDay, Unit } from '../data/types';
import { menu, fillMenu } from '../lib/menu';
import { brussels } from '../lib/open-state';
import { priceLabel } from '../lib/price';
import { wa, type Locale } from '../i18n/ui';
import { eindejaarT } from '../i18n/eindejaar';
import '../styles/sections.css';
// row 15b (13.10, D-35): the menu card „Menukaart” — design/css/menu-card.css v1 ported 1:1, global like header.css
import '../styles/menu-card.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = eindejaarT[locale];
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/feestmenu-eindejaar', ro: '/ro/sarbatori' };
const path = alternates[locale];
const homePath = locale === 'ro' ? '/ro' : '/';
const m = menu('eindejaar-2026');
const fill = (s: string) => fillMenu(s, m, locale);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/eindejaar/*.{jpg,jpeg,png,webp}', { eager: true });
// the hero (row 14e, PageHero.astro) = q19, the festive platter (2048 × 1330) — the band under the head before it
const band = (photos.eindejaar as Photo[])[0];
const bandImg = files[`../assets/${band.src}`]?.default;
if (!bandImg) throw new Error(`photos.json: src/assets/${band.src} not found`);
const heroFrames = [{ img: bandImg, alt: band.alt[locale], focalX: band.focalX, focalY: band.focalY, zoomX: band.zoomX, zoomY: band.zoomY }];
// spec §4: the lead goes under the hero when the text block covers more of it than the home's own (64,6 % at 390 × 844,
// measured from the block's top to the hero's foot) — 65,5 % NL (stays), 70,4 % RO (moves) with the lead in (row 14e
// [MEASURED-OURS] local 19.10)
const LEAD_BELOW = locale === 'ro';

// the card's units as the §5.22 table writes them (/l: soep, lexicon §5.19 13.10; /portie: the vleeshoofdgerechten,
// row 15a) — RO: the §6 Produse tag units, /pers. · /buc. · /kg · /l · /porție
const unit: Partial<Record<Unit, string>> = locale === 'ro'
  ? { pers: '/pers.', stuk: '/buc.', kg: '/kg', liter: '/l', portie: '/porție' }
  : { pers: '/pers.', stuk: '/stuk', kg: '/kg', liter: '/l', portie: '/portie' };
// row 5b (D-34): a row whose dish has its own photo (src/lib/thumbs.ts) carries it at 56 px left of the name
// row 15d: `lang` = the RO dish names of ro-feest on the NL page; their price cell is „prijs in de winkel” (price.ts)
type Row = { id?: string; thumb?: boolean; name: string; lang?: string; line: string; price: string; unit: string };
const row = (i: MenuItem): Row => ({
  id: i.id,
  thumb: !!thumbOf(i.id),
  name: i.name[locale],
  lang: i.nameLang && i.nameLang !== locale ? i.nameLang : undefined,
  line: i.line?.[locale] ?? '',
  price: priceLabel({ ...i, category: '', line: { nl: '', ro: '' } }, locale),
  unit: unit[i.unit] ?? '',
});
// row 15a: the owners' folder's eight sections in its order (menus.json `sections`); the page's extra rows (RO: Porc de
// Crăciun, D 7) get a rubric with its own index pill (row 15b, §6 Sărbători 13.10 13:00). Row 15d: menus.json's ninth
// section ro-feest (Georgiana 19.10) stays last — the RO extra rubric sits before it; its `lead` = the price note.
type Sec = { id: string; name: string; note?: string; lead?: string; rows: Row[] };
const menuSecs: Sec[] = m.sections.map((s) => ({ id: s.id, name: s.name[locale], note: s.note?.[locale], lead: s.lead?.[locale], rows: m.items.filter((i) => i.section === s.id).map(row) }));
const extra: Sec[] = t.card.extraSection && t.card.extraRows.length ? [{ ...t.card.extraSection, rows: t.card.extraRows as Row[] }] : [];
const at = menuSecs.findIndex((s) => s.id === 'ro-feest');
const sections = (at < 0 ? [...menuSecs, ...extra] : [...menuSecs.slice(0, at), ...extra, ...menuSecs.slice(at)]).filter((s) => s.rows.length);

// holiday hours — row 15 follow-ups (§5.30): every hours.json `special` day from today (Brussels, at build) on, by
// date, the same rows and order as /contact (24.12 … 3.01), so „Andere dagen: de gewone openingsuren.” stays true;
// `slots: []` → gesloten; the day's note after the hours. No special day yet → the four §5.22 rows with [UREN].
const today = brussels(new Date(), hours.timeZone).day.toISOString().slice(0, 10);
const special = ((hours.special ?? []) as SpecialDay[]).filter((s) => s.date >= today).sort((x, y) => x.date.localeCompare(y.date));
const dateFmt = new Intl.DateTimeFormat(locale === 'ro' ? 'ro-RO' : 'nl-BE', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const span = (sp: SpecialDay) => (!sp.slots.length ? t.holiday.closed : sp.slots.map((s) => `${s.open}${locale === 'ro' ? '-' : '–'}${s.close}`).join(', ')); // RO: hyphen (LR-T03)
const holiday = special.length
  ? special.map((sp) => ({ label: dateFmt.format(new Date(`${sp.date}T00:00:00Z`)), text: span(sp), note: sp.note?.[locale] }))
  : t.holiday.days.map((d) => ({ label: d.label, text: t.holiday.unknown, note: undefined as string | undefined }));

const waHref = `${wa(t.waSrc)}&text=${encodeURIComponent(t.waMessage)}`;

const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${origin}${path}#webpage`,
    url: `${origin}${path}`,
    name: t.title,
    description: t.description,
    inLanguage: locale === 'ro' ? 'ro-BE' : 'nl-BE',
    isPartOf: { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: 'Slagerij John' },
    about: { '@id': `${origin}/#shop` },
  },
];
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld} navVariant="hero">
  <HeroPreload slot="head" frame={heroFrames[0]} />
  <main id="main" class="ej">
    <PageHero locale={locale} id="eh-title" eyebrow={t.eyebrow} h1={t.h1} accent={fill(t.accent)} lead={fill(t.lead)} leadBelow={LEAD_BELOW} frames={heroFrames}>
      <a class="btn btn--primary btn--lg" href={t.primaryHref}>{t.primary}</a>
      <a class="btn btn--secondary btn--lg" href={waHref} rel="nofollow"><WaIcon /><span>{t.whatsapp}</span></a>
    </PageHero>

    <div class="container ej-body">
      <section class="es" aria-labelledby="es-title">
        <h2 class="eyebrow es__title" id="es-title">{t.steps.eyebrow}</h2>
        <ol class="es__list">
          {t.steps.items.map((s, i) => (
            <li class="es__step"><span class="es__n" aria-hidden="true">{i + 1}</span><span>{fill(s)}</span></li>
          ))}
        </ol>
      </section>

      <section class="em on-ink" id={t.card.id} aria-labelledby="em-title">
        <p class="em__eyebrow">{t.card.eyebrow}</p>
        <h2 class="em__title" id="em-title">{t.card.title}</h2>
        <nav class="em__index" aria-label={t.card.index}>
          {sections.filter((s) => s.name).map((s) => <a href={`#em-${s.id}`}>{s.name}</a>)}
        </nav>
        <div class="em__sections">
          {sections.map((s) => (
            <div class="em__sec" id={`em-${s.id}`}>
              {s.name && <h3 class="em__sec-title"><span class="em__sec-name">{s.name}</span>{s.note && <span class="em__sec-note">{s.note}</span>}</h3>}
              {s.lead && <p class="em__sec-lead">{s.lead}</p>}
              <dl class="em__rows">
                {s.rows.map((r) => (
                  <div class:list={['em__row', { 'em__row--thumb': r.thumb }]}>
                    {r.thumb && r.id
                      ? <dt><Thumb id={r.id} locale={locale} size={56} /><span class="em__dish"><span lang={r.lang}>{r.name}</span>{r.line && <span class="em__line">{r.line}</span>}</span></dt>
                      : <dt>{r.lang ? <span lang={r.lang}>{r.name}</span> : r.name}{r.line && <span class="em__line">{r.line}</span>}</dt>}
                    <dd><span class="em__price">{r.price}</span><span class="em__unit">{r.unit}</span></dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
        <p class="em__owners">{t.card.ownersLine}</p>
        <div class="em__msg">
          <p class="em__msg-label">{t.card.msgLabel}</p>
          <p class="em__msg-text">{t.waMessage}</p>
        </div>
        <a class="btn btn--light em__folder" href={t.card.folderHref}>{t.card.folder}</a>
        <p class="em__deadline">{fill(t.card.deadline)}</p>
      </section>

      {t.ro && <div class="er">
        <div class="er__box" lang="ro">
          <p class="er__label">{t.ro.label}</p>
          <p class="er__text">{fillMenu(t.ro.text, m, 'ro')}</p>
        </div>
        <a class="er__link" href={t.ro.href} lang="ro" hreflang="ro-BE">{t.ro.link}</a>
      </div>}

      <section class="eo" aria-labelledby="eo-title">
        <h2 class="eo__title" id="eo-title">{t.holiday.eyebrow}</h2>
        <dl class="eo__rows">
          {holiday.map((d) => (
            <div class="eo__row"><dt>{d.label}</dt><dd>{d.text}{d.note && <span class="eo__note">{d.note}</span>}</dd></div>
          ))}
        </dl>
        <p class="eo__other">{t.holiday.other}</p>
      </section>
    </div>

    <Faq locale={locale} title={t.faq} page="eindejaar" />

    <div class="container ej-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<style>
  /* row 5b (D-34): a card row with its dish's photo — the 56 px square opens the row, the name beside it, the dotted
     leader and the price on the photo's middle line. Rows without a photo keep menu-card.css as it is. */
  .em__row--thumb { align-items: center; }
  .em__row--thumb::before { top: 50%; }
  .em__row--thumb dt { display: flex; align-items: center; gap: 10px; }
  .em__dish { min-width: 0; }
  /* row 15d: the ro-feest price note under its heading — a sentence, so not the nowrap unit note of menu-card.css */
  .em__sec-lead { margin: -4px 0 2px; font-size: 13px; line-height: 1.45; color: var(--ox-tint); }
  /* ── phone = board Eindejaar (390); the hero: PageHero.astro (row 14e) ── */

  .ej-body { display: flex; flex-direction: column; }

  /* three steps (board: eyebrow ox, 36 px ox-ring numerals in Fraunces 17, text 15) */
  .es { display: flex; flex-direction: column; gap: 12px; padding: 26px 0 24px; }
  .es__title { margin: 0; font-family: var(--f-ui); font-weight: 600; letter-spacing: 0.16em; }
  .es__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .es__step { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: center; font-size: 15px; line-height: 1.4; }
  .es__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--ox);
    border-radius: 999px;
    color: var(--ox);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 17px;
  }

  /* the menu card: src/styles/menu-card.css (row 15b, D-35) — the whole card; only its place in the desktop grid stays here */

  /* „Și în română” (board: tag-coloured box, label 11 upper muted, text 14; the link under it) */
  .er { display: flex; flex-direction: column; gap: 10px; padding-top: 20px; }
  .er__box { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-radius: 10px; background: var(--tag); }
  .er__label { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .er__text { margin: 0; font-size: 14px; line-height: 1.45; }
  .er__link { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; }

  /* holiday hours (board: the hours card — padding 18, hairline, radius 14, --card; title Fraunces 20; rows 13 tabular) */
  .eo { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; padding: 18px; border: 1px solid var(--line); border-radius: var(--r-tile); background: var(--card); }
  .eo__title { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 20px; line-height: 1.1; letter-spacing: 0; }
  .eo__rows { display: flex; flex-direction: column; gap: 6px; margin: 0; font-size: 13px; font-variant-numeric: tabular-nums; }
  .eo__row { display: flex; justify-content: space-between; gap: 16px; }
  .eo__row dt { color: var(--muted); }
  .eo__row dd { margin: 0; text-align: right; }
  .eo__note { display: block; font-size: 12px; color: var(--muted); }
  .eo__other { margin: 0; font-size: 13px; line-height: 1.45; color: var(--muted); }

  .ej-byline { padding-top: 20px; padding-bottom: 28px; }
  .ej-byline p { margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; color: var(--muted); }

  /* ── desktop (derived, D-30) ── */
  @media (min-width: 960px) {
    /* steps, RO box, holiday hours left; the menu card right */
    .ej-body {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'steps menu' 'ro menu' 'hours menu' '. menu';
      grid-template-rows: auto auto auto 1fr;
      gap: 0 56px;
      align-items: start;
      padding-top: 72px;
    }
    .es { grid-area: steps; gap: 18px; padding: 0; }
    .es__step { font-size: var(--fs-body); }
    .em { grid-area: menu; }
    .er { grid-area: ro; padding-top: 32px; }
    .eo { grid-area: hours; margin-top: 24px; padding: 22px 24px; }
    .eo__rows { font-size: 14px; gap: 8px; }

    .ej-byline { padding-top: 56px; padding-bottom: 80px; }
  }
</style>
