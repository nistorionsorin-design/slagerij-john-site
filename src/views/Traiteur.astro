---
// /traiteur — Traiteur & barbecue aan huis (stage 6). Canvas board Traiteur (mobile 390) is the concept (D-30), its
// sections in order: the dark photo head (eyebrow · H1 · accent) · lead + Vraag een offerte + Bel ons · four photo tiles
// (static, D-13) · the gallery (row 19, Gallery.astro) · prices per person (counter tags) · occasions · the quote
// form (#offerte) · region · FAQ · byline.
// Row 14e (19.10, design/heroes-unify.md): the head is the home's hero (PageHero.astro) — the photo full screen on the
// phone, the sign over it, the text and both buttons at its foot.
// Desktop derived (D-30): the hero full bleed with the text over its left side; tiles in a 3-column mosaic
// that keeps each photo's own shape (two wide, two 4:3); tags right of their heading (the /producten pattern); the form in two columns.
// Strings: src/i18n/traiteur.ts (lexicon §5.21). FAQ: the five §5.11 „Traiteur” items (faq.json pages.traiteur).
// JSON-LD (§5.21): BreadcrumbList (§8.4) + WebPage (§8.2) about the shop's @id — no Offer and no FoodService node while
// every price here is [PRIJS] (S-03). RO (/ro/catering, stage 9): lexicon §6 „Catering” (`traiteurRo`); one view, two
// pages: src/pages/traiteur.astro and src/pages/ro/catering.astro.
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ArtPicture from '../components/ArtPicture.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreload from '../components/HeroPreload.astro';
import CounterTag from '../components/CounterTag.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import entity from '../data/entity.json';
import photos from '../data/photos.json';
import type { Photo } from '../data/types';
import { item, priceLabel } from '../lib/price';
import { heroPhoto } from '../lib/hero';
import { rubric, photoFile } from '../lib/thumbs';
import { traiteurT } from '../i18n/traiteur';
import type { Locale } from '../i18n/ui';
import '../styles/sections.css';
import '../styles/tiles.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = traiteurT[locale];
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/traiteur', ro: '/ro/catering' };
const path = alternates[locale];
const homePath = locale === 'ro' ? '/ro' : '/';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/{hero,home,traiteur}/*.{jpg,jpeg,png,webp}', { eager: true });
const file = (src: string) => {
  const m = files[`../assets/${src}`];
  if (!m) throw new Error(`photos.json: src/assets/${src} not found`);
  return m.default;
};

// the hero (row 14e, PageHero.astro) = the hero's John at the grill, id john-bbq (the board's photo; picked by id,
// D-38), AVIF quality 40 as the head before it; the 2:1 desktop crop keeps the top of the frame: John's face sits in
// its top fifth (the 50 % centre would cut it)
const head = heroPhoto('john-bbq');
const heroFrames = [{ img: file(head.src), alt: head.alt[locale], focalX: head.focalX, focalY: head.focalY, zoomX: head.zoomX, zoomY: head.zoomY, desktopFocalY: 20 }];
// spec §4: the lead goes under the hero when the text block covers more of it than the home's own (64,6 % at 390 × 844,
// measured from the block's top to the hero's foot) — here 75,2 % NL / 78,3 % RO with the lead in (row 14e
// [MEASURED-OURS] local 19.10)
const LEAD_BELOW = true;

// the tiles: phone = the board's 2-column grid (1:1, 1:1, 7:4 wide, 2:1 wide); desktop = a 3-column mosaic
// („t1 t1 t2 / t3 t4 t4”): the two wide photos (the platter, the BBQ trailer — tile 4 since 08.10 15:40, §5.21) in the
// wide slots, the two 4:3 photos at 4:3-ish
const shapes = [
  { m: 1, d: 2.9, dSizes: '60vw' },
  { m: 1, d: 1.43, dSizes: '30vw' },
  { m: 1.75, d: 1.43, dSizes: '30vw' },
  { m: 2.05, d: 2.9, dSizes: '60vw' },
];
// row 22g: tile 4 „Barbecue aan huis met kok” = product-photos.json `rubrics.bbq-aan-huis` (John at the grill, the
// owners' form photo of 27.10, its file a 4:3 cut that keeps his head and the grill in both wide boxes); the trailer
// photo p08 stays in the home loop
const aanHuis = rubric('bbq-aan-huis');
const tiles = (photos.traiteur as Photo[]).map((p, i) => {
  const own = i === 3 ? aanHuis : null;
  const ph = own ? { img: photoFile(own), alt: own.alt[locale], focalX: own.focalX, focalY: own.focalY } : null;
  return {
    ...t.tiles.items[i],
    alt: ph?.alt ?? p.alt[locale],
    mobile: { img: ph?.img ?? file(p.src), ratio: shapes[i].m, max: 1080, sizes: shapes[i].m > 1.2 ? '100vw' : '50vw', focalX: ph?.focalX ?? p.focalX, focalY: ph?.focalY ?? p.focalY },
    desktop: { img: ph?.img ?? file(p.srcDesktop ?? p.src), ratio: shapes[i].d, max: 1600, sizes: shapes[i].dSizes, focalX: ph?.focalX ?? p.focalX, focalY: ph?.focalY ?? p.focalY },
  };
});

// per person: a row tied to a product takes that product's price (gourmet 9 = the bestelbon's), else its own string
const rows = t.perPerson.rows.map((r) => ({ ...r, price: r.product ? priceLabel(item(r.product), locale) : r.price, unit: r.unit ?? t.perPerson.unit }));

const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${origin}${path}#webpage`,
    url: `${origin}${path}`,
    name: t.title,
    description: t.description,
    inLanguage: locale === 'ro' ? 'ro-BE' : 'nl-BE',
    isPartOf: { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: 'Slagerij John' },
    about: { '@id': `${origin}/#shop` },
  },
];

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld} navVariant="hero">
  <HeroPreload slot="head" frame={heroFrames[0]} quality={40} />
  <main id="main" class="tr">
    <PageHero locale={locale} id="th-title" eyebrow={t.eyebrow} h1={t.h1} accent={t.accent} lead={t.lead} leadBelow={LEAD_BELOW} frames={heroFrames} quality={40}>
      <a class="btn btn--quote btn--lg" href={`#${t.anchor}`}>{t.primary}</a>
      <a class="btn btn--secondary btn--lg" href={`tel:${entity.telephone}`}>{t.call}</a>
    </PageHero>

    <section class="container tt" aria-labelledby="tt-title">
      <h2 class="vh" id="tt-title">{t.tiles.label}</h2>
      <ul class="tt__grid">
        {tiles.map((x, i) => (
          <li class={`tt__tile tt__tile--${i + 1}`}>
            <ArtPicture class="tt__pic" mobile={x.mobile} desktop={x.desktop} alt={x.alt} />
            <div class="tt__label">
              <h3 class="tt__name">{x.name}</h3>
              <p class="tt__sub">{x.sub}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* row 19 (D-45): the gallery, under „Wat u bij ons bestelt”, above „Per persoon”; the wrapper keeps the page's
        container (gallery.css sets the block's own vertical margin) */}
    <div class="container">
      <Gallery locale={locale} />
    </div>

    <section class="container tp" aria-labelledby="tp-title">
      <div class="tp__head">
        <p class="eyebrow">{t.perPerson.eyebrow}</p>
        <h2 class="tp__title" id="tp-title">{t.perPerson.title}</h2>
        <p class="tp__intro">{t.perPerson.intro}</p>
      </div>
      <ul class="tp__tags">
        {rows.map((r) => (
          <li><CounterTag name={r.name} line={r.line} price={r.price} unit={r.unit} tone={r.ink ? 'ink' : 'paper'} /></li>
        ))}
      </ul>
      <div class="tp__more">
        <p>{t.perPerson.more}</p>
        <a class="link-arrow" href={t.perPerson.moreHref}>{t.perPerson.moreLink}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </section>

    <section class="container to" aria-labelledby="to-title">
      <h2 class="eyebrow to__title" id="to-title">{t.occasions.eyebrow}</h2>
      <ul class="to__chips">
        {t.occasions.items.map((o) => <li class="to__chip">{o}</li>)}
      </ul>
    </section>

    <section class="container tq" id={t.anchor}>
      <QuoteForm locale={locale} t={t.quote} occasions={t.occasions.items} src={locale === 'ro' ? 'ro-catering-form' : 'traiteur-form'} />
    </section>

    <section class="container tg" aria-labelledby="tg-title">
      <h2 class="eyebrow tg__title" id="tg-title">{t.region.eyebrow}</h2>
      <p class="tg__line">{t.region.line}</p>
      <p class="tg__towns">{t.region.towns.join(' · ')}</p>
      <p class="tg__line">{t.region.closing}</p>
    </section>

    <Faq locale={locale} title={t.faq} page="traiteur" />

    <div class="container tr-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<style>
  /* ── phone = board Traiteur (390); the hero: PageHero.astro (row 14e) ── */
  /* tiles (board: 2 columns, gap 10, radius 14 on ink, heights 170 / 170 / 200 / 170; label at the foot over a scrim):
     the tile itself is src/styles/tiles.css (shared with /producten since D-37 v5); here only this page's two wide ones */
  .tt { padding-top: 20px; padding-bottom: 4px; }
  .tt__tile--3 { grid-column: span 2; height: 200px; }
  .tt__tile--4 { grid-column: span 2; }

  /* prices per person (board: eyebrow · H2 26 · counter tags gap 10; the last one ink) */
  .tp { display: flex; flex-direction: column; gap: 14px; padding-top: 28px; padding-bottom: 8px; }
  .tp__head { display: flex; flex-direction: column; gap: 14px; }
  .tp__head .eyebrow { margin: 0; }
  .tp__title { margin: 0; font-size: 26px; line-height: 1.05; letter-spacing: -0.015em; }
  .tp__intro { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); max-width: 56ch; }
  .tp__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tp__more { display: flex; flex-direction: column; gap: 2px; }
  .tp__more p { margin: 0; font-size: 14px; line-height: 1.45; }
  .tp__more .link-arrow { align-self: flex-start; }

  /* occasions: text chips, no links (board: tag colour, 32 px, 13/500) */
  .to { display: flex; flex-direction: column; gap: 12px; padding-top: 24px; padding-bottom: 24px; }
  /* the two eyebrow-sized h2s keep the eyebrow's UI face (an h2 takes the display face from tokens.css) */
  .to__title, .tg__title { margin: 0; font-family: var(--f-ui); font-weight: 600; letter-spacing: 0.16em; }
  .to__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .to__chip { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border-radius: var(--r-chip); background: var(--tag); font-size: 13px; font-weight: 500; }

  .tq { scroll-margin-top: 64px; }

  /* region */
  .tg { display: flex; flex-direction: column; gap: 10px; padding-top: 26px; }
  .tg__line { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .tg__towns { margin: 0; font-size: 14px; line-height: 1.6; font-weight: 600; max-width: 62ch; }

  .tr-byline { padding-top: 20px; padding-bottom: 28px; }
  .tr-byline p { margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; color: var(--muted); }

  /* ── desktop (derived, D-30; the hero: PageHero.astro) ── */
  @media (min-width: 960px) {
    .tt { padding-top: 56px; padding-bottom: 0; }
    .tt__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas: 't1 t1 t2' 't3 t4 t4';
      grid-template-rows: 300px 300px;
      gap: 16px;
    }
    .tt__tile--3, .tt__tile--4 { height: auto; grid-column: auto; }
    .tt__tile--1 { grid-area: t1; }
    .tt__tile--2 { grid-area: t2; }
    .tt__tile--3 { grid-area: t3; }
    .tt__tile--4 { grid-area: t4; }

    .tp {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'head tags' 'more tags';
      grid-template-rows: auto 1fr;
      gap: 16px 56px;
      align-items: start;
      padding-top: 80px;
      padding-bottom: 0;
    }
    .tp__head { grid-area: head; }
    .tp__title { font-size: 44px; line-height: 1; letter-spacing: -0.02em; }
    .tp__intro { font-size: var(--fs-body); line-height: 1.5; }
    .tp__tags { grid-area: tags; gap: 12px; }
    .tp__more { grid-area: more; gap: 6px; }
    .tp__more p { font-size: var(--fs-body); line-height: 1.5; color: var(--muted); max-width: 44ch; }

    .to { flex-direction: row; align-items: center; gap: 24px; padding-top: 56px; padding-bottom: 40px; }
    .to__chip { min-height: 36px; padding: 0 16px; font-size: 14px; }

    .tq { scroll-margin-top: 80px; }

    .tg {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 10px 56px;
      padding-top: 80px;
    }
    .tg__title { grid-row: span 3; }
    .tg__line { font-size: var(--fs-body); }
    .tg__towns { font-family: var(--f-display); font-weight: 500; font-size: 26px; line-height: 1.35; letter-spacing: -0.01em; }

    .tr-byline { padding-top: 56px; padding-bottom: 80px; }
  }
</style>
