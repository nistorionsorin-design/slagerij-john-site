---
// /bestellen — the bestelbon (stage 5, D-23, docs/order-flow.md). Canvas board Bestellen (mobile 390): intro (eyebrow ·
// H1 · lead · open chip) then OrderForm (pickup/delivery · 1 products · free request · 2 when · 3 details · allergy ·
// the slip + the two sends), then the FAQ. Desktop derived (D-30): the intro on the 1440 container, the form in two columns.
// Strings: src/i18n/bestellen.ts (lexicon §5.20). FAQ: the three §5.11 „Bestellen” items (faq.json pages.bestellen).
// JSON-LD: BreadcrumbList (lexicon §8.4). RO (/ro/comanda, stage 9): lexicon §6 „Comandă” (`bestellenRo`); one view, two
// pages: src/pages/bestellen.astro and src/pages/ro/comanda.astro.
import Base from '../layouts/Base.astro';
import OpenChip from '../components/OpenChip.astro';
import OrderForm from '../components/OrderForm.astro';
import Faq from '../components/Faq.astro';
import { bestellenT } from '../i18n/bestellen';
import type { Locale } from '../i18n/ui';
// board.css = the folds of OrderForm (D-47 D1). Imported here, not in OrderForm (row 22b): since /producten dropped it
// (D-51) it is no longer a shared chunk, and from the view it keeps its old place after OrderForm's own styles — its
// `.ocat__more .ocat__sub` (10 px) and the form's `.ocat__sub` (8 px) weigh the same, the later one wins.
import '../styles/board.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = bestellenT[locale];
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/bestellen', ro: '/ro/comanda' };
const path = alternates[locale];
const homePath = locale === 'ro' ? '/ro' : '/';
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
];
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld} fonts={['display', 'ui']}>
  <main id="main" class="ob">
    <div class="container ob-intro">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="ob-intro__h1">{t.h1}</h1>
      <p class="ob-intro__lead">{t.lead}</p>
      <OpenChip locale={locale} variant="p" class="ob-intro__chip" />
    </div>
    <div class="container">
      <OrderForm locale={locale} />
    </div>
    <Faq locale={locale} title={t.faq} page="bestellen" />
  </main>
</Base>

<style>
  /* board Bestellen: intro 24 px under the sign, H1 Fraunces 38, lead 15 */
  .ob-intro { display: flex; flex-direction: column; gap: 14px; padding-top: 24px; padding-bottom: 24px; }
  .ob-intro__h1 { margin: 0; font-size: 38px; line-height: 1.02; letter-spacing: -0.02em; }
  .ob-intro__lead { margin: 0; font-size: 15px; line-height: 1.45; max-width: 56ch; }
  .ob-intro :global(.ob-intro__chip) { align-self: flex-start; }
  @media (min-width: 960px) {
    .ob-intro { padding-top: 56px; padding-bottom: 40px; gap: 18px; }
    .ob-intro__h1 { font-size: 64px; line-height: 1; }
    .ob-intro__lead { font-size: 17px; line-height: 1.5; }
  }
</style>
