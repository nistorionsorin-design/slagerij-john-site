---
// /bbq-pakketten — BBQ & gourmet (row 10a, 15.10). No board: the page follows /traiteur (D-30) — the dark photo head
// (eyebrow · H1 · accent over the photo; lead + Bestel via WhatsApp + Bestel online below) · block 1 BBQ (three counter
// tags, each with its link) · block 2 Gourmet (the q12 photo, four counter tags) · three steps · FAQ · byline.
// Row 14e (19.10, design/heroes-unify.md): the head is the home's hero (PageHero.astro) — the photo full screen on the
// phone, the sign over it, the text and both buttons at its foot.
// Desktop derived (D-30): the hero full bleed, text left; the two blocks put their heading left of the tags (the
// /traiteur price block), the gourmet photo as a print in the left column.
// Strings: src/i18n/bbq.ts (lexicon §5.24). Prices: products.json (gourmet + fondue `[OWNER]` 13.10; the BBQ Colli
// null → [PRIJS]); the BBQ-pakket per person is [PRIJS] in the strings. FAQ: faq.json pages.bbq (§5.24, four items).
// JSON-LD (§5.24): BreadcrumbList (§8.4) + WebPage (§8.2) about the shop's @id + one Product per gourmet row (§8.3,
// per persoon = unitCode C62). Fondue is „vanaf €10”: its offer is an AggregateOffer (a kind of Offer) with lowPrice
// 10 — the schema.org home of lowPrice. No Offer on a [PRIJS] row (S-03): the three BBQ rows carry none.
// RO (/ro/gratar): lexicon §6 „Grătar” (`bbqRo`); one view, two pages: src/pages/bbq-pakketten.astro and
// src/pages/ro/gratar.astro. Row 14 (16.10): three tiles of the phone shoot in block 1 (photos.json `bbq`,
// role tile: #36 gemarineerde koteletten (14d, 19.10: not ribbetjes) · #15 kipreepjes · #20 schnitzels — three across under the tags, 1:1); the `head` candidate
// (#37) was measured against hero frame 4 and the better one kept: mobile LCP 3,0 / 3,0 s with #37 vs 2,9 / 3,0 s with
// frame 4 [MEASURED-OURS] local 16.10 → frame 4 stayed; #37 stays in photos.json `bbq` for Dan's eye.
// Row 14e follow-up (Dan 19.10: „for bbq paketen we need to find a better nice photo” → 19:1x „use these two photos on
// black background … changing nicely and with the ken burns”): the hero is Dan's two cut-outs on the hero's ink,
// photos.json `bbq` role hero — the round BBQ platter (q03) and two trays of marinated meat, skewers and white sausage —
// drawn whole (PageHero `whole`), crossfading on the home's rhythm with its Ken Burns; the loop's script
// (src/scripts/page-hero.ts) is imported below.
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ArtPicture from '../components/ArtPicture.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreload from '../components/HeroPreload.astro';
import CounterTag from '../components/CounterTag.astro';
import WaIcon from '../components/WaIcon.astro';
import Faq from '../components/Faq.astro';
import photos from '../data/photos.json';
import type { Photo } from '../data/types';
import { item, priceLabel, products } from '../lib/price';
import { rubric, photoFile } from '../lib/thumbs';
import { wa, type Locale } from '../i18n/ui';
import { bbqT } from '../i18n/bbq';
import '../styles/sections.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = bbqT[locale];
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/bbq-pakketten', ro: '/ro/gratar' };
const path = alternates[locale];
const homePath = locale === 'ro' ? '/ro' : '/';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/{hero,home,bbq}/*.{jpg,jpeg,png,webp}', { eager: true });
const file = (src: string) => {
  const m = files[`../assets/${src}`];
  if (!m) throw new Error(`photos.json: src/assets/${src} not found`);
  return m.default;
};

// the hero (row 14e follow-up): the two cut-outs, whole — on the phone 112 % of the hero wide (the platters' rims run
// out at the sides), their top just under the sign; AVIF quality 40 as /traiteur's
const shoot = photos.bbq as Photo[];
const heroFrames = shoot
  .filter((p) => p.role === 'hero')
  .map((p) => ({ img: file(p.src), alt: p.alt[locale], focalX: p.focalX, focalY: p.focalY, zoomX: p.zoomX, zoomY: p.zoomY, whole: { width: 112, top: 9 } }));
// spec §4: the lead goes under the hero when the text block covers more of it than the home's own (64,6 % at 390 × 844,
// measured from the block's top to the hero's foot) — here 71,1 % NL / 75,2 % RO with the lead in (row 14e
// [MEASURED-OURS] local 19.10)
const LEAD_BELOW = true;

// block 1's tiles (row 14): three 1:1 crops, a third of the column each
const tiles = shoot.filter((p) => p.role === 'tile').map((p) => ({
  alt: p.alt[locale],
  crop: { img: file(p.src), ratio: 1, max: 480, sizes: '(min-width: 1440px) 240px, (min-width: 960px) 17vw, calc((100vw - 60px) / 3)', focalX: p.focalX, focalY: p.focalY },
}));

// row 22g: block 1's third row „Barbecue aan huis” gets its print — product-photos.json `rubrics.bbq-aan-huis` (John at
// the grill, the owners' form photo of 27.10; its file is already the 4:3 cut), 4:3 under the rows on the phone, in the
// left column under the heading from 960 (block 2's gourmet print)
const aanHuis = rubric('bbq-aan-huis');
const aanHuisPic = aanHuis && { img: photoFile(aanHuis), ratio: 4 / 3, max: 1080, sizes: '(min-width: 1440px) 480px, (min-width: 960px) 34vw, calc(100vw - 40px)', focalX: aanHuis.focalX, focalY: aanHuis.focalY };

// block 2's photo = the home grid's „BBQ & gourmet” file (q12, photos.json categories[1]) with its alt (§5.14)
const gp = (photos.categories as Photo[])[1];
const gourmetPic = {
  mobile: { img: file(gp.src), ratio: 1.75, max: 1080, sizes: 'calc(100vw - 40px)', focalX: gp.focalX, focalY: gp.focalY },
  desktop: { img: file(gp.src), ratio: 0.9, max: 1080, sizes: '(min-width: 1440px) 540px, 38vw', focalX: gp.focalX, focalY: gp.focalY },
};

const waText = `&text=${encodeURIComponent(t.waMessage)}${locale === 'ro' ? '&lang=ro' : ''}`;
const waHref = (src: string) => `${wa(src)}${waText}`;

// block 1: a row tied to a product takes that product's price ([PRIJS] while null); the others carry their own
const bbqRows = t.bbq.rows.map((r) => ({
  ...r,
  price: r.product ? priceLabel(item(r.product), locale) : r.price,
  to: r.waSrc ? waHref(r.waSrc) : r.href,
}));
const gourmetRows = t.gourmet.rows.map((r) => ({ ...r, p: item(r.product), price: priceLabel(item(r.product), locale) }));

const category = products.categories.find((c) => c.id === 'gourmet')?.name[locale];
const shop = { '@id': `${origin}/#shop` };
const unitSpec = { unitCode: 'C62', unitText: locale === 'ro' ? 'de persoană' : 'per persoon' };
const productLd = (r: (typeof gourmetRows)[number]) => {
  const price = r.p.price!.toFixed(2);
  const url = `${origin}${path}#${r.product}`;
  return {
    '@type': 'Product',
    '@id': url,
    name: r.name,
    category,
    brand: { '@type': 'Brand', name: 'Slagerij John' },
    offers: r.p.priceFrom
      ? {
          '@type': 'AggregateOffer',
          url,
          priceCurrency: 'EUR',
          lowPrice: price,
          priceSpecification: { '@type': 'UnitPriceSpecification', priceCurrency: 'EUR', minPrice: price, ...unitSpec },
          availableAtOrFrom: shop,
          seller: shop,
        }
      : {
          '@type': 'Offer',
          url,
          priceCurrency: 'EUR',
          price,
          priceSpecification: { '@type': 'UnitPriceSpecification', priceCurrency: 'EUR', price, ...unitSpec },
          availableAtOrFrom: shop,
          seller: shop,
        },
  };
};

const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${origin}${path}#webpage`,
    url: `${origin}${path}`,
    name: t.title,
    description: t.description,
    inLanguage: locale === 'ro' ? 'ro-BE' : 'nl-BE',
    isPartOf: { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: 'Slagerij John' },
    about: shop,
  },
  ...gourmetRows.filter((r) => r.p.price !== null).map(productLd),
];

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld} navVariant="hero">
  <HeroPreload slot="head" frame={heroFrames[0]} quality={40} />
  <main id="main" class="bq">
    <PageHero locale={locale} id="bh-title" eyebrow={t.eyebrow} h1={t.h1} accent={t.accent} lead={t.lead} leadBelow={LEAD_BELOW} frames={heroFrames} quality={40}>
      <a class="btn btn--primary btn--lg" href={waHref(t.primarySrc)} rel="nofollow"><WaIcon /><span>{t.primary}</span></a>
      <a class="btn btn--secondary btn--lg" href={t.secondaryHref}>{t.secondary}</a>
    </PageHero>

    <section class="container bb" aria-labelledby="bb-title">
      <div class="bb__head">
        <p class="eyebrow">{t.bbq.eyebrow}</p>
        <h2 class="bb__title" id="bb-title">{t.bbq.title}</h2>
        <p class="bb__intro">{t.bbq.intro}</p>
      </div>
      <ul class="bb__rows">
        {bbqRows.map((r) => (
          <li class="bb__row">
            <CounterTag name={r.name} line={r.sub} price={r.price} unit={r.unit} tone={r.ink ? 'ink' : 'paper'} />
            <a class="link-arrow" href={r.to} rel={r.waSrc ? 'nofollow' : undefined}>{r.link}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
          </li>
        ))}
      </ul>
      {aanHuis && aanHuisPic && (
        <div class="bb__print">
          <ArtPicture mobile={aanHuisPic} alt={aanHuis.alt[locale]} quality={50} />
        </div>
      )}
      <ul class="bb__tiles">
        {tiles.map((p) => <li><ArtPicture mobile={p.crop} alt={p.alt} quality={50} /></li>)}
      </ul>
      <div class="bb__more">
        <p>{t.bbq.more}</p>
        <a class="link-arrow" href={t.bbq.moreHref}>{t.bbq.moreLink}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </section>

    <section class="container bg" aria-labelledby="bg-title">
      <div class="bg__photo">
        <ArtPicture class="bg__pic" mobile={gourmetPic.mobile} desktop={gourmetPic.desktop} alt={gp.alt[locale]} quality={50} />
      </div>
      <div class="bg__head">
        <p class="eyebrow">{t.gourmet.eyebrow}</p>
        <h2 class="bg__title" id="bg-title">{t.gourmet.title}</h2>
        <p class="bg__intro">{t.gourmet.intro}</p>
      </div>
      <ul class="bg__tags">
        {gourmetRows.map((r) => (
          <li><CounterTag id={r.product} name={r.name} price={r.price} unit={t.gourmet.unit} /></li>
        ))}
      </ul>
      <div class="bg__more">
        <p>{t.gourmet.more}</p>
        <a class="link-arrow" href={t.gourmet.moreHref}>{t.gourmet.moreLink}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </section>

    <section class="container bs" aria-labelledby="bs-title">
      <h2 class="eyebrow bs__title" id="bs-title">{t.steps.eyebrow}</h2>
      <ol class="bs__list">
        {t.steps.items.map((s, i) => (
          <li class="bs__step">
            <span class="bs__n" aria-hidden="true">{i + 1}</span>
            <p class="bs__text"><strong>{s.title}</strong> {s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <Faq locale={locale} title={t.faq} page="bbq" />

    <div class="container bq-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<script>
  // the hero's frame 2 (row 14e follow-up): PageHero's loop driver, inserted after `load`, live once decoded
  import '../scripts/page-hero.ts';
</script>

<style>
  /* ── phone: the hero is PageHero.astro (row 14e); then the blocks in the 20 px gutters ── */
  /* the two blocks: eyebrow · H2 26 · intro · counter tags gap 10 (the /traiteur price block) */
  .bb, .bg { display: flex; flex-direction: column; gap: 14px; padding-top: 28px; padding-bottom: 8px; }
  .bb__head, .bg__head { display: flex; flex-direction: column; gap: 14px; }
  .bb__head .eyebrow, .bg__head .eyebrow { margin: 0; }
  .bb__title, .bg__title { margin: 0; font-size: 26px; line-height: 1.05; letter-spacing: -0.015em; }
  .bb__intro, .bg__intro { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); max-width: 56ch; }
  .bb__rows, .bg__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  /* each BBQ tag carries its own link under it, set in from the tag's pin */
  .bb__row { display: flex; flex-direction: column; }
  .bb__row .link-arrow { align-self: flex-start; margin-left: 34px; }
  /* row 14: three square tiles under the BBQ tags */
  .bb__tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .bb__tiles :global(picture) { display: block; aspect-ratio: 1; border-radius: var(--r-tile); overflow: hidden; background: var(--ink); }
  .bb__tiles :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* row 22g: John at the grill, 4:3, the tiles' radius */
  .bb__print :global(picture) { display: block; aspect-ratio: 4 / 3; border-radius: var(--r-tile); overflow: hidden; background: var(--ink); }
  .bb__print :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bb__more, .bg__more { display: flex; flex-direction: column; gap: 2px; }
  .bb__more p, .bg__more p { margin: 0; font-size: 14px; line-height: 1.45; }
  .bb__more .link-arrow, .bg__more .link-arrow { align-self: flex-start; }

  /* the gourmet photo: a 7:4 band in the gutters (the Eindejaar band) */
  .bg { padding-top: 24px; }
  .bg__photo :global(picture) { display: block; height: 200px; border-radius: var(--r-tile); overflow: hidden; background: var(--ink); }
  .bg__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* three steps: the Eindejaar steps (numbered ring, oxblood), the step's first words in bold */
  .bs { display: flex; flex-direction: column; gap: 12px; padding-top: 26px; padding-bottom: 8px; }
  .bs__title { margin: 0; font-family: var(--f-ui); font-weight: 600; letter-spacing: 0.16em; }
  .bs__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .bs__step { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
  .bs__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--ox);
    border-radius: 999px;
    color: var(--ox);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 17px;
  }
  .bs__text { margin: 0; padding-top: 7px; font-size: 15px; line-height: 1.45; max-width: 56ch; }
  .bs__text strong { font-weight: 600; }

  .bq-byline { padding-top: 20px; padding-bottom: 28px; }
  .bq-byline p { margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; color: var(--muted); }

  /* ── desktop (derived, D-30) ── */
  @media (min-width: 960px) {
    /* the blocks: heading left (5fr), tags right (7fr) — the /traiteur price block */
    .bb, .bg {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 16px 56px;
      align-items: start;
      padding-top: 80px;
      padding-bottom: 0;
    }
    /* row 22g: the print in the left column under the heading, beside the rows' foot and the tiles */
    .bb { grid-template-areas: 'head rows' 'print rows' 'print tiles' 'more tiles'; grid-template-rows: auto auto auto 1fr; }
    .bb__print { grid-area: print; }
    .bb__print :global(picture) { border-radius: var(--r-frame); }
    .bb__tiles { grid-area: tiles; gap: 14px; }
    .bb__head { grid-area: head; }
    .bb__rows { grid-area: rows; gap: 12px; }
    .bb__more { grid-area: more; }
    /* gourmet: the photo as a print in the left column, the heading and the tags right of it */
    .bg { grid-template-areas: 'photo head' 'photo tags' 'photo more'; grid-template-rows: auto auto 1fr; gap: 20px 56px; }
    .bg__photo { grid-area: photo; }
    .bg__photo :global(picture) { height: auto; aspect-ratio: 0.9; border-radius: var(--r-frame); }
    .bg__head { grid-area: head; }
    .bg__tags { grid-area: tags; gap: 12px; }
    .bg__more { grid-area: more; }
    .bb__title, .bg__title { font-size: 44px; line-height: 1; letter-spacing: -0.02em; }
    .bb__intro, .bg__intro { font-size: var(--fs-body); line-height: 1.5; }
    .bb__more, .bg__more { gap: 6px; }
    .bb__more p, .bg__more p { font-size: var(--fs-body); line-height: 1.5; color: var(--muted); max-width: 44ch; }

    /* steps: three across */
    .bs { padding-top: 80px; gap: 20px; }
    .bs__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .bs__text { font-size: var(--fs-body); line-height: 1.5; }

    .bq-byline { padding-top: 56px; padding-bottom: 80px; }
  }
</style>
