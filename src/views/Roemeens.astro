---
// /roemeense-specialiteiten — Roemeense specialiteiten (row 10b, 15.10). No board: the page follows /bbq-pakketten
// (D-30) — the dark photo head on hero frame 1, the mici on the grill (eyebrow · H1 · accent over the photo; lead +
// Bestel via WhatsApp + Bekijk de prijzen below) · „Wat wij maken” (three blocks: name · line · cooking line · price,
// the mici block with its photo) · the Roemeense tapas (photo + its counter tag) · the towns line · FAQ · byline.
// Desktop derived (D-30): hero frame 1 is a tall file (886 × 1920), so the head is /bbq-pakketten's dark print with the
// photo as a print in its right column (5fr) instead of behind the text — a 2:1 crop of it would be upscaled. The mici
// block spans the row (photo beside its text), the two others sit side by side under it; the tapas block is the
// /bbq-pakketten gourmet block (photo left, heading and tag right).
// Strings: src/i18n/roemeens.ts (lexicon §5.25; RO §6 „Mici și specialități”). Names and prices: products.json
// (`roemeens` null → [PRIJS] / [PREȚ]; `tapas-ro` €45 `[OWNER]` 13.10). Photos: the mici block = q07 and the tapas = q05,
// the files row 5b put in src/assets/products/ (product-photos.json `mici` / `tapas-ro`, with their alt). FAQ: faq.json
// pages.roemeens (§5.25, four items).
// JSON-LD (§5.25): BreadcrumbList (§8.4) + WebPage (§8.2) about the shop's @id + a Product per per-kg block WITHOUT
// Offer (every price [PRIJS], S-03) + the tapas as Product + Offer 45 EUR (per piece: plain price, §8.3).
// One view, two pages: src/pages/roemeense-specialiteiten.astro and src/pages/ro/mici-si-specialitati.astro. No new
// image file, no script.
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ArtPicture from '../components/ArtPicture.astro';
import CounterTag from '../components/CounterTag.astro';
import WaIcon from '../components/WaIcon.astro';
import Faq from '../components/Faq.astro';
import photos from '../data/photos.json';
import type { Photo } from '../data/types';
import { item, priceLabel, unitLabel, products } from '../lib/price';
import { thumbOf } from '../lib/thumbs';
import { wa, type Locale } from '../i18n/ui';
import { roemeensT } from '../i18n/roemeens';
import '../styles/sections.css';

export interface Props { locale: Locale }
const { locale } = Astro.props;
const t = roemeensT[locale];
const origin = 'https://slagerij-john.be';
const alternates = { nl: '/roemeense-specialiteiten', ro: '/ro/mici-si-specialitati' };
const path = alternates[locale];
const homePath = locale === 'ro' ? '/ro' : '/';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/{hero,products}/*.{jpg,jpeg,png,webp}', { eager: true });
const file = (src: string) => {
  const m = files[`../assets/${src}`];
  if (!m) throw new Error(`src/assets/${src} not found`);
  return m.default;
};

// the head = hero frame 1, the mici on the grill (§5.25): square on the phone (/bbq-pakketten's head), a 0.85 print in
// the desktop head's right column; AVIF quality 40 as the other heads
const head = (photos.hero as Photo[])[0];
const headPic = {
  mobile: { img: file(head.src), ratio: 1, max: 1080, sizes: '100vw', focalX: head.focalX, focalY: head.focalY },
  desktop: { img: file(head.src), ratio: 0.85, max: 1080, sizes: '(min-width: 1440px) 520px, 38vw', focalX: head.focalX, focalY: head.focalY },
};

// the block photos (row 5b's files, product-photos.json): the mici at block size, the tapas as the gourmet print
const photoOf = (id: string) => {
  const p = thumbOf(id);
  if (!p) throw new Error(`product-photos.json: no photo for "${id}"`);
  return p;
};
const mp = photoOf('mici');
const miciPic = {
  mobile: { img: file(mp.src), ratio: 4 / 3, max: 1080, sizes: 'calc(100vw - 40px)', focalX: mp.focalX, focalY: mp.focalY },
  desktop: { img: file(mp.src), ratio: 4 / 3, max: 1080, sizes: '(min-width: 1440px) 560px, 40vw', focalX: mp.focalX, focalY: mp.focalY },
};
const tp = photoOf('tapas-ro');
const tapasPic = {
  mobile: { img: file(tp.src), ratio: 1.75, max: 1080, sizes: 'calc(100vw - 40px)', focalX: tp.focalX, focalY: tp.focalY },
  desktop: { img: file(tp.src), ratio: 0.9, max: 1080, sizes: '(min-width: 1440px) 540px, 38vw', focalX: tp.focalX, focalY: tp.focalY },
};

const waHref = `${wa(t.primarySrc)}&text=${encodeURIComponent(t.waMessage)}${locale === 'ro' ? '&lang=ro' : ''}`;

const blocks = t.products.items.map((b) => {
  const p = item(b.product);
  return { ...b, p, name: p.name[locale], price: priceLabel(p, locale), unit: unitLabel(p.unit, locale), photo: b.product === 'mici' };
});
const tapas = item('tapas-ro');

const shop = { '@id': `${origin}/#shop` };
const category = products.categories.find((c) => c.id === 'roemeens')?.name[locale];
const brand = { '@type': 'Brand', name: 'Slagerij John' };
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.crumbs.home, item: `${origin}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.crumbs.page, item: `${origin}${path}` },
    ],
  },
  {
    '@type': 'WebPage',
    '@id': `${origin}${path}#webpage`,
    url: `${origin}${path}`,
    name: t.title,
    description: t.description,
    inLanguage: locale === 'ro' ? 'ro-BE' : 'nl-BE',
    isPartOf: { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: 'Slagerij John' },
    about: shop,
  },
  // the three per-kg blocks: no Offer while the price is [PRIJS] (S-03: schema says what the page shows)
  ...blocks.map((b) => ({
    '@type': 'Product',
    '@id': `${origin}${path}#${b.product}`,
    name: b.name,
    description: b.line,
    category,
    brand,
  })),
  {
    '@type': 'Product',
    '@id': `${origin}${path}#${tapas.id}`,
    name: tapas.name[locale],
    description: t.tapas.line,
    category: products.categories.find((c) => c.id === 'tapas')?.name[locale],
    brand,
    offers: {
      '@type': 'Offer',
      url: `${origin}${path}#${tapas.id}`,
      priceCurrency: 'EUR',
      price: tapas.price!.toFixed(2),
      eligibleQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'C62' },
      availableAtOrFrom: shop,
      seller: shop,
    },
  },
];

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
// Lucide „utensils” before the cooking line
const utensils = '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>';
---
<Base title={t.title} description={t.description} locale={locale} path={path} alternates={alternates} jsonld={jsonld}>
  <main id="main" class="rs">
    <div class="rs-headwrap">
      <section class="rh" aria-labelledby="rh-title">
        <div class="rh__media">
          <ArtPicture class="rh__pic" mobile={headPic.mobile} desktop={headPic.desktop} alt={head.alt[locale]} quality={40} priority />
        </div>
        <div class="rh__title">
          <p class="eyebrow rh__eyebrow">{t.eyebrow}</p>
          <h1 class="rh__h1" id="rh-title">{t.h1} <span class="accent rh__accent">{t.accent}</span></h1>
        </div>
        <div class="rh__body">
          <p class="rh__lead">{t.lead}</p>
          <div class="rh__buttons">
            <a class="btn btn--primary btn--lg" href={waHref} rel="nofollow"><WaIcon /><span>{t.primary}</span></a>
            <a class="btn btn--secondary btn--lg" href={t.secondaryHref}>{t.secondary}</a>
          </div>
        </div>
      </section>
    </div>

    <section class="container rp" aria-labelledby="rp-title">
      <h2 class="eyebrow rp__label" id="rp-title">{t.products.label}</h2>
      <ul class="rp__list">
        {blocks.map((b) => (
          <li class:list={['rp__item', { 'rp__item--photo': b.photo }]}>
            <article class="rb" id={b.product}>
              {b.photo && (
                <div class="rb__photo">
                  <ArtPicture mobile={miciPic.mobile} desktop={miciPic.desktop} alt={mp.alt[locale]} quality={50} />
                </div>
              )}
              <div class="rb__text">
                <span class="rb__pin" aria-hidden="true"></span>
                <h3 class="rb__name">{b.name}</h3>
                <p class="rb__line">{b.line}</p>
                <p class="rb__cook"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={utensils} /><span>{b.cook}</span></p>
                <p class="rb__price">
                  <span class:list={['rb__amount', { 'rb__amount--ph': b.price.startsWith('[') }]}>{b.price}</span>
                  <span class="rb__unit">{b.unit}</span>
                </p>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <div class="rp__more">
        <p>{t.products.more}</p>
        <a class="link-arrow" href={t.products.moreHref}>{t.products.moreLink}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </section>

    <section class="container rt" aria-labelledby="rt-title">
      <div class="rt__photo">
        <ArtPicture mobile={tapasPic.mobile} desktop={tapasPic.desktop} alt={tp.alt[locale]} quality={50} />
      </div>
      <div class="rt__head">
        <p class="eyebrow">{t.tapas.eyebrow}</p>
        <h2 class="rt__title" id="rt-title">{t.tapas.title}</h2>
        <p class="rt__line">{t.tapas.line}</p>
      </div>
      <div class="rt__tag">
        <CounterTag id={tapas.id} name={tapas.name[locale]} price={priceLabel(tapas, locale)} unit={unitLabel(tapas.unit, locale)} />
        <a class="link-arrow" href={t.tapas.href}>{t.tapas.link}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </section>

    <section class="container rr" aria-labelledby="rr-title">
      <div class="rr__in">
        <h2 class="eyebrow rr__title" id="rr-title">{t.region.eyebrow}</h2>
        <p class="rr__text">{t.region.text}</p>
      </div>
    </section>

    <Faq locale={locale} title={t.faq} page="roemeens" />

    <div class="container rs-byline">
      <p>{t.byline}</p>
    </div>
  </main>
</Base>

<style>
  /* ── phone: /bbq-pakketten's head (a 400 px dark photo, full bleed, title at its foot over the scrims; lead and the
     two buttons below it on paper), then the blocks in the 20 px gutters ── */
  .rh { display: grid; grid-template-areas: 'media' 'body'; background: var(--paper); }
  .rh__media, .rh__title { grid-area: media; }
  .rh__media { position: relative; height: 400px; background: var(--ink); overflow: hidden; }
  .rh__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rh__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(21, 17, 13, 0.35) 0%, rgba(21, 17, 13, 0.05) 30%, rgba(21, 17, 13, 0.35) 55%, rgba(21, 17, 13, 0.96) 100%),
      rgba(21, 17, 13, 0.24);
  }
  .rh__title {
    position: relative;
    z-index: 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 var(--gutter) 22px;
    color: var(--on-ink);
  }
  .rh__eyebrow { margin: 0; color: var(--accent); }
  .rh__h1 { margin: 0; font-size: 36px; line-height: 1.02; letter-spacing: -0.02em; color: var(--on-ink); }
  .rh__accent { display: block; margin-top: 12px; font-size: var(--fs-accent); line-height: 1.05; color: var(--accent); }
  .rh__body { grid-area: body; display: flex; flex-direction: column; gap: 12px; padding: 22px var(--gutter) 8px; }
  .rh__lead { margin: 0; font-size: 15px; line-height: 1.45; max-width: 60ch; }
  .rh__buttons { display: flex; flex-direction: column; gap: 10px; }
  .rh__buttons .btn { width: 100%; }

  /* „Wat wij maken”: three counter blocks — the counter tag's paper, hairline, radius and pin hole (CounterTag), grown
     to hold a line, the cooking line and the price; the mici block opens with its photo */
  .rp { display: flex; flex-direction: column; gap: 14px; padding-top: 28px; padding-bottom: 8px; }
  .rp__label { margin: 0; font-family: var(--f-ui); font-weight: 600; letter-spacing: 0.16em; }
  .rp__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .rb {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--tag);
    border: 1px solid var(--tag-line);
    border-radius: var(--r-tag);
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .rb__pin {
    position: absolute;
    left: 13px;
    top: 22px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--tag-pin);
  }
  .rb__photo :global(picture) { display: block; aspect-ratio: 4 / 3; background: var(--ink); }
  .rb__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rb__text { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 16px 16px 14px 34px; }
  .rb__name { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 22px; line-height: 1.1; letter-spacing: 0; }
  .rb__line { margin: 0; font-size: 14px; line-height: 1.45; }
  .rb__cook { margin: 0; display: flex; align-items: flex-start; gap: 8px; font-size: var(--fs-caption); line-height: 1.4; color: var(--muted); }
  .rb__cook svg { flex: 0 0 auto; margin-top: 1px; color: var(--ox); }
  .rb__price {
    margin: 6px 0 0;
    padding-top: 10px;
    border-top: 1px dashed var(--tag-line);
    display: flex;
    align-items: baseline;
    gap: 3px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .rb__amount { font-size: var(--fs-price); font-weight: 700; letter-spacing: -0.02em; color: var(--ox); }
  .rb__amount--ph { font-size: 20px; }
  .rb__unit { font-size: var(--fs-caption); color: var(--muted); }
  .rp__more { display: flex; flex-direction: column; gap: 2px; }
  .rp__more p { margin: 0; font-size: 14px; line-height: 1.45; }
  .rp__more .link-arrow { align-self: flex-start; }

  /* the tapas: /bbq-pakketten's gourmet block — a 7:4 band in the gutters, heading, the tag with its link */
  .rt { display: flex; flex-direction: column; gap: 14px; padding-top: 28px; padding-bottom: 8px; }
  .rt__photo :global(picture) { display: block; height: 200px; border-radius: var(--r-tile); overflow: hidden; background: var(--ink); }
  .rt__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rt__head { display: flex; flex-direction: column; gap: 14px; }
  .rt__head .eyebrow { margin: 0; }
  .rt__title { margin: 0; font-size: 26px; line-height: 1.05; letter-spacing: -0.015em; }
  .rt__line { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); max-width: 56ch; }
  .rt__tag { display: flex; flex-direction: column; }
  .rt__tag .link-arrow { align-self: flex-start; margin-left: 34px; }

  /* the towns: one card line (the hours card's paper) */
  .rr { padding-top: 28px; padding-bottom: 8px; }
  .rr__in { display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 16px; border: 1px solid var(--line); border-radius: var(--r-tile); background: var(--card); }
  .rr__title { margin: 0; font-family: var(--f-ui); font-weight: 600; letter-spacing: 0.16em; }
  .rr__text { margin: 0; font-size: 15px; line-height: 1.45; max-width: 60ch; }

  .rs-byline { padding-top: 20px; padding-bottom: 28px; }
  .rs-byline p { margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.5; color: var(--muted); }

  /* ── desktop (derived, D-30) ── */
  @media (min-width: 960px) {
    /* the head: /bbq-pakketten's dark print in the container; text left (7fr), the tall frame as a print right (5fr) */
    .rs-headwrap { max-width: var(--container); margin: 0 auto; padding: 32px var(--gutter) 0; }
    .rh {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'title media' 'body media';
      grid-template-rows: 1fr auto;
      min-height: min(640px, calc(100svh - 140px));
      border-radius: var(--r-frame-lg);
      overflow: hidden;
      background: var(--ink);
    }
    .rh__media { grid-area: media; height: auto; }
    .rh__media :global(picture) { display: block; position: absolute; inset: 0; }
    .rh__media::after { background: linear-gradient(90deg, rgba(21, 17, 13, 0.55) 0%, rgba(21, 17, 13, 0) 22%); }
    .rh__title { grid-area: title; gap: 16px; padding: 64px 48px 0 56px; }
    .rh__h1 { font-size: clamp(48px, 4.4vw, 68px); line-height: 1; letter-spacing: -0.025em; }
    .rh__accent { margin-top: 14px; font-size: clamp(30px, 2.6vw, 40px); }
    .rh__body { position: relative; z-index: 1; gap: 22px; padding: 24px 48px 56px 56px; color: var(--on-ink); }
    .rh__lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--on-ink-muted); }
    .rh__buttons { flex-direction: row; flex-wrap: wrap; gap: 12px; }
    .rh__buttons .btn { width: auto; }
    /* on the dark print the outline button takes the on-ink skin (buttons.css .on-ink, scoped to desktop here) */
    .rh__buttons .btn--secondary { color: var(--on-ink); border-color: rgba(244, 237, 224, 0.55); }
    .rh__buttons .btn--secondary:focus-visible { outline-color: var(--on-ink); }
  }
  @media (min-width: 960px) and (hover: hover) {
    .rh__buttons .btn--secondary:hover { background: rgba(244, 237, 224, 0.1); border-color: var(--on-ink); box-shadow: none; }
  }
  @media (min-width: 960px) {
    /* the blocks: the mici across the row (photo left, text right), the two others side by side */
    .rp { gap: 20px; padding-top: 80px; padding-bottom: 0; }
    .rp__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .rp__item--photo { grid-column: 1 / -1; }
    .rp__item--photo .rb { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .rp__item--photo .rb__photo :global(picture) { aspect-ratio: 4 / 3; height: auto; }
    .rp__item--photo .rb__text { justify-content: center; padding: 32px 40px 28px 48px; }
    .rp__item--photo .rb__price { margin-top: 10px; }
    .rp__item--photo .rb__pin { left: 20px; top: 40px; }
    .rb { height: 100%; }
    .rb__text { gap: 8px; padding: 22px 24px 20px 40px; flex: 1 1 auto; }
    .rb__pin { left: 16px; top: 28px; }
    .rb__name { font-size: 30px; }
    .rb__line { font-size: var(--fs-body); line-height: 1.5; max-width: 52ch; }
    .rb__cook { font-size: 14px; }
    .rb__price { margin-top: auto; padding-top: 14px; }
    .rp__more { gap: 6px; }
    .rp__more p { font-size: var(--fs-body); line-height: 1.5; color: var(--muted); }

    /* the tapas: the photo as a print in the left column, the heading and the tag right of it */
    .rt {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'photo head' 'photo tag';
      grid-template-rows: auto 1fr;
      gap: 20px 56px;
      align-items: start;
      padding-top: 80px;
      padding-bottom: 0;
    }
    .rt__photo { grid-area: photo; }
    .rt__photo :global(picture) { height: auto; aspect-ratio: 0.9; border-radius: var(--r-frame); }
    .rt__head { grid-area: head; }
    .rt__tag { grid-area: tag; gap: 6px; max-width: 520px; }
    .rt__title { font-size: 44px; line-height: 1; letter-spacing: -0.02em; }
    .rt__line { font-size: var(--fs-body); line-height: 1.5; }

    .rr { padding-top: 56px; }
    .rr__in { flex-direction: row; align-items: baseline; gap: 32px; padding: 28px 32px; border-radius: var(--r-frame); }
    .rr__title { flex: 0 0 auto; }
    .rr__text { font-size: var(--fs-lead); line-height: 1.5; max-width: none; }

    .rs-byline { padding-top: 56px; padding-bottom: 80px; }
  }
</style>
