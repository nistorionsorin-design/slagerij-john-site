---
// STUB until stage 9 (RO pages): /ro/catering exists at stage 6 only so /traiteur has its reciprocal hreflang pair
// (gate: every hreflang target is a built page that links back). Meta (53 / 147), eyebrow, H1, accent and lead = lexicon
// §6 „Catering” verbatim; the rest of the RO page (tiles, prices, the quote form with the RO message) is stage 9.
import Base from '../../layouts/Base.astro';
const alternates = { nl: '/traiteur', ro: '/ro/catering' };
// BreadcrumbList (lexicon §8.4; §6 „Catering”: Acasă › Catering — the home item as the other RO stubs name it)
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Măcelăria John', item: 'https://slagerij-john.be/ro' },
      { '@type': 'ListItem', position: 2, name: 'Catering', item: 'https://slagerij-john.be/ro/catering' },
    ],
  },
];
---
<Base title="Catering românesc în Flandra de Vest | Măcelăria John" description="Platouri reci și calde, aperitive, pachete BBQ, grătar la domiciliu cu bucătar, din Zwevezele: botez, nuntă, aniversare. Cere o ofertă pe WhatsApp." locale="ro" path="/ro/catering" alternates={alternates} jsonld={jsonld}>
  <main id="main" class="container stub">
    <p class="eyebrow">Catering</p>
    <h1 class="stub__h1">Catering românesc în Flandra de Vest. <span class="accent stub__accent">Botez, nuntă, aniversare sau un grătar cu bucătar, la tine acasă.</span></h1>
    <p class="stub__lead">Traiteur, cum se spune aici, adică mâncare gătită la comandă pentru petreceri: platouri reci, aperitive și bufete, pachete gourmet și BBQ cu mici și cârnați de casă, de ridicat din Zwevezele sau livrate acasă. Și grătar la domiciliu cu bucătar, în zona Wingene, Tielt, Lichtervelde și Roeselare.</p>
  </main>
</Base>

<style>
  /* the /ro/comanda stub's sizes until stage 9 */
  .stub { display: flex; flex-direction: column; gap: 14px; padding-top: 24px; padding-bottom: 48px; min-height: 50vh; }
  .stub__h1 { margin: 0; font-size: 38px; line-height: 1.02; letter-spacing: -0.02em; }
  .stub__accent { display: block; margin-top: 8px; font-size: var(--fs-accent); line-height: 1.05; }
  .stub__lead { margin: 0; font-size: 15px; line-height: 1.45; max-width: 60ch; }
  @media (min-width: 960px) {
    .stub { padding-top: 56px; gap: 18px; }
    .stub__h1 { font-size: 64px; line-height: 1; }
    .stub__accent { margin-top: 12px; font-size: 40px; }
    .stub__lead { font-size: 17px; line-height: 1.5; }
  }
</style>
