---
// STUB until stage 9 (RO pages): /ro/comanda exists at stage 5 only so /bestellen has its reciprocal hreflang pair
// (gate: every hreflang target is a built page that links back). Meta (55 / 153), eyebrow, H1 and lead = lexicon §6
// „Comandă” verbatim; the bestelbon itself in RO is stage 9 (same keys as §5.20).
import Base from '../../layouts/Base.astro';
const alternates = { nl: '/bestellen', ro: '/ro/comanda' };
// BreadcrumbList (lexicon §8.4): the brand for the home, the page = §6 footer label „Comandă”
const jsonld = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Măcelăria John', item: 'https://slagerij-john.be/ro' },
      { '@type': 'ListItem', position: 2, name: 'Comandă', item: 'https://slagerij-john.be/ro/comanda' },
    ],
  },
];
---
<Base title="Comandă online – ridicare sau livrare | Măcelăria John" description="Comandă online la Măcelăria John: carne proaspătă, colli, gourmet, tapas și preparate calde. Ridici din magazin sau livrăm acasă, la ora pe care o alegi." locale="ro" path="/ro/comanda" alternates={alternates} jsonld={jsonld}>
  <main id="main" class="container stub">
    <p class="eyebrow">Comandă</p>
    <h1 class="stub__h1">Comandă ca la tejghea.</h1>
    <p class="stub__lead">Alegi produsele, ziua și ora; plătești când ridici sau la livrare. Fără cont.</p>
  </main>
</Base>

<style>
  /* the /bestellen intro's sizes (bestellen.astro) until stage 9 */
  .stub { display: flex; flex-direction: column; gap: 14px; padding-top: 24px; padding-bottom: 48px; min-height: 50vh; }
  .stub__h1 { margin: 0; font-size: 38px; line-height: 1.02; letter-spacing: -0.02em; }
  .stub__lead { margin: 0; font-size: 15px; line-height: 1.45; max-width: 56ch; }
  @media (min-width: 960px) {
    .stub { padding-top: 56px; gap: 18px; }
    .stub__h1 { font-size: 64px; line-height: 1; }
    .stub__lead { font-size: 17px; line-height: 1.5; }
  }
</style>
