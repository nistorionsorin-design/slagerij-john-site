---
// Home NL. Stage 1: the hero. The body (trust strip, toog, categories, …) is stage 3.
// Title and description: lexicon §5.12, home NL (shortened 06.10), verbatim.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
const alternates = { nl: '/', ro: '/ro' };
---
<Base
  title="Slagerij John – slager & traiteur in Zwevezele, zondag open"
  description="Slager & traiteur in Zwevezele: dagvers vlees, huisbereide gerechten, BBQ- en feestschotels, Roemeense specialiteiten. Zondag open. Bestel via WhatsApp."
  locale="nl" path="/" alternates={alternates} navVariant="ink">
  <main id="main">
    <Hero locale="nl" />
  </main>
</Base>
