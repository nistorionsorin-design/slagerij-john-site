---
// Head, hreflang pair, canonical, JSON-LD, self-hosted fonts, and the layout frame:
// skip link · Header (the sign) · <slot> (the page's <main>) · Menu (the no-JS list; header.ts
// makes it the overlay) · Footer · BottomBar (mobile).
// No facts here: entity.json and hours.json carry the values.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/buttons.css';
import entity from '../data/entity.json';
import hours from '../data/hours.json';
import type { Day } from '../data/types';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import { ui, home, wa, routeHref, type Locale } from '../i18n/ui';
// Stage 7b: the woff2 files the first screen uses, preloaded. The same files fonts.css references (Vite emits one
// /_astro/ copy each), so the preload is the request the @font-face uses. Without it the fonts are found only after
// style and layout and fetched at VeryHigh priority, which Lighthouse's simulation counts as render-blocking (the
// 2,3 s first paint on every page, 08.10). A preload starts them from the first bytes of <head>; fetchpriority low
// keeps them behind the hero photo (the mobile LCP): at High they shared its bandwidth and the home LCP jumped to
// 5,2 s in 2 of 5 Lighthouse runs, at low 3,3 s in 5 of 5 (09.10). The text meanwhile shows in the metric-matched
// fallback (fonts.css), so the swap does not reflow.
import frauncesNormal from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import frauncesNormalRo from '../assets/fonts/fraunces-ro-opsz-normal.woff2?url';
import frauncesItalicRo from '../assets/fonts/fraunces-ro-opsz-italic.woff2?url';
import interTightRo from '../assets/fonts/inter-tight-ro-wght-normal.woff2?url';

const fontFiles = {
  display: [frauncesNormal, frauncesNormalRo],
  italic: [frauncesItalic, frauncesItalicRo],
  ui: [interTight, interTightRo],
} as const;
type FontKey = keyof typeof fontFiles;

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  alternates?: { nl: string; ro: string };
  noindex?: boolean;
  /** 'hero': the sign is dark glass over the hero photo; 'paper': solid ink, with a spacer below (stage 0b2). */
  navVariant?: 'paper' | 'hero';
  /** the page shows the hours card (Hours.astro, id="openingsuren"): the footer's hours then drop that id */
  hoursCard?: boolean;
  /** the page's own JSON-LD nodes (BreadcrumbList, Product …), one more ld+json block after the shop's */
  jsonld?: Record<string, unknown>[];
  /** the font families the first screen draws (stage 7b): their woff2 files are preloaded — the Latin file, plus the
      Romanian subset (Ă ă Ș ș Ț ț) on a ro page. Default: all three; /bestellen has no italic above the fold. */
  fonts?: FontKey[];
  /** extra properties of the shop's own node (stage 8, /contact: hasMap, specialOpeningHoursSpecification) — the same
      @id, so the page extends the entity instead of declaring a second one (lexicon §8.1) */
  shop?: Record<string, unknown>;
}

const { title, description, locale, path, alternates, noindex = false, navVariant = 'paper', hoursCard = false, jsonld: pageLd, fonts = ['display', 'italic', 'ui'], shop } = Astro.props;
const preloads = fonts.map((k) => (locale === 'ro' ? fontFiles[k] : fontFiles[k].slice(0, 1))).flat();

const origin = 'https://slagerij-john.be';
const abs = (p: string) => `${origin}${p === '/' ? '/' : p}`;
const htmlLang = locale === 'ro' ? 'ro-BE' : 'nl-BE';
const t = ui[locale];
// Pages without a pair (404) switch language at the home pages.
const alt = alternates ?? { nl: home.nl, ro: home.ro };

// ButcherShop only when entity.json is filled; an empty stub emits a neutral
// WebSite node so no half-empty entity is ever published (the gate warns).
const regular = hours.regular as Day[];
const jsonld = entity.name
  ? {
      '@context': 'https://schema.org',
      '@type': 'ButcherShop',
      '@id': `${origin}/#shop`,
      name: entity.name,
      legalName: entity.legalName || undefined,
      vatID: entity.vatID || undefined,
      url: `${origin}/`,
      telephone: entity.telephone || undefined,
      email: entity.email || undefined,
      address: { '@type': 'PostalAddress', ...entity.address },
      geo:
        entity.geo.latitude !== null
          ? { '@type': 'GeoCoordinates', latitude: entity.geo.latitude, longitude: entity.geo.longitude }
          : undefined,
      areaServed: entity.areaServed,
      sameAs: entity.sameAs,
      knowsLanguage: entity.knowsLanguage,
      openingHoursSpecification: regular.flatMap((d) =>
        d.slots.map((s) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: `https://schema.org/${d.dayOfWeek}`,
          opens: s.open,
          closes: s.close,
        })),
      ),
      ...shop,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: `${origin}/`,
      inLanguage: ['nl-BE', 'ro-BE'],
    };
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin fetchpriority="low" />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4EDE0" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={abs(path)} />
        {alternates && (
          <>
            <link rel="alternate" hreflang="nl-BE" href={abs(alternates.nl)} />
            <link rel="alternate" hreflang="ro-BE" href={abs(alternates.ro)} />
            <link rel="alternate" hreflang="x-default" href={abs(alternates.nl)} />
          </>
        )}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={abs(path)} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={htmlLang.replace('-', '_')} />
      </>
    )}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    {pageLd && pageLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': pageLd })} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header locale={locale} path={path} alternates={alt} variant={navVariant} />
    <slot />
    <Menu locale={locale} path={path} />
    <Footer locale={locale} alternates={alt} hoursAnchor={!hoursCard} />
    {/* the open chip's hours (D-20): data for src/scripts/open-chip.ts, not executed (CSP-safe) */}
    <script type="application/json" id="hours" set:html={JSON.stringify({ timeZone: hours.timeZone, regular: hours.regular, special: hours.special })} />
    <BottomBar
      telHref={`tel:${entity.telephone}`}
      waHref={wa(`bar-mobile-${locale}`)}
      mapHref={routeHref(entity.geo.latitude, entity.geo.longitude)}
      telLabel={t.bar.tel}
      waLabel={t.bar.wa}
      mapLabel={t.bar.route}
      navLabel={t.bar.label}
    />
  </body>
</html>
